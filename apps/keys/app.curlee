// SPDX-License-Identifier: GPL-3.0
//
// apps/keys — echoes the polled keyboard (kernel/keyboard.curlee) on serial.
//
// Every frame polls the controller once and prints
//   KEYS: <hhh>   when the set of held keys changed: the three hex digits
//                 of kbd_state(), so 001 is up, 010 is Z, 030 is Z and X
//   TAP: <hhh>    when keys were pressed and released within one poll, so
//                 that kbd_state() never showed them: the keys, from
//                 kbd_take_seen()
// after "KEYS: ready" at start. Its frame loop does not wait for the timer,
// so it polls as fast as the machine runs. It returns when Z, X and C are
// held together (the kernel then prints its halt line), so `make
// qemu-kbd-smoke` can end the run from the keyboard.
//
// Two things at start exist for that smoke test. It prints "KEYS: booted"
// and waits half a second before it starts the driver, so that keys sent in
// that time are bytes the driver finds already queued, and must drop. And it
// asks the controller to report the mouse, so that mouse bytes arrive on the
// same data port as the keyboard's: the driver must not read them as keys.
// A mouse byte is a movement, and a move of 44 counts sends 0x2C, the make
// code of Z.

const KEYS_QUIT: Int = 112;
// Microseconds between "KEYS: booted" and starting the driver.
const KEYS_STALE_WINDOW_US: Int = 500000;

static keys_last: Int = 0;

// Prints the low 12 bits of `v` (0..4095) as 3 lowercase hex digits.
fn keys_put_hex(pm: cap phys.mem, v: Int) -> Unit
  [ requires 0 <= v && v < 4096; ]
{
  let hundreds: Int = v / 256;
  let rest: Int = v - hundreds * 256;
  let tens: Int = rest / 16;
  let ones: Int = rest - tens * 16;
  keys_put_digit(pm, hundreds);
  keys_put_digit(pm, tens);
  keys_put_digit(pm, ones);
  return;
}

fn keys_put_digit(pm: cap phys.mem, d: Int) -> Unit
  [ requires 0 <= d && d < 16; ]
{
  if (d < 10) {
    putc(pm, 48 + d);
  } else {
    putc(pm, 87 + d);
  }
  return;
}

// "KEYS: " (the label of a line about the keys, whatever it says).
fn keys_label(pm: cap phys.mem) -> Unit {
  putc(pm, 75);  // K
  putc(pm, 69);  // E
  putc(pm, 89);  // Y
  putc(pm, 83);  // S
  putc(pm, 58);  // :
  putc(pm, 32);  // space
  return;
}

// "KEYS: " or "TAP: " (label) then the value and a newline.
fn keys_line(pm: cap phys.mem, tap: Bool, v: Int) -> Unit
  [ requires 0 <= v && v < 4096; ]
{
  if (tap) {
    putc(pm, 84);  // T
    putc(pm, 65);  // A
    putc(pm, 80);  // P
    putc(pm, 58);  // :
    putc(pm, 32);  // space
  } else {
    keys_label(pm);
  }
  keys_put_hex(pm, v);
  putc(pm, 10);  // newline
  return;
}

// "KEYS: <word>\n", word being "ready" or "booted" (ready is true).
fn keys_status(pm: cap phys.mem, ready: Bool) -> Unit {
  keys_label(pm);
  if (ready) {
    putc(pm, 114);  // r
    putc(pm, 101);  // e
    putc(pm, 97);   // a
    putc(pm, 100);  // d
    putc(pm, 121);  // y
  } else {
    putc(pm, 98);   // b
    putc(pm, 111);  // o
    putc(pm, 111);  // o
    putc(pm, 116);  // t
    putc(pm, 101);  // e
    putc(pm, 100);  // d
  }
  putc(pm, 10);  // newline
  return;
}

// Waits (a bounded number of polls) until the controller can take a byte.
fn keys_wait_input_free(pm: cap phys.mem) -> Unit {
  for (i in 0..100000) {
    let status: Int = kbd_status(pm);
    if ((status & 2) == 0) {
      break;
    }
  }
  return;
}

// Command 0xD4 sends the next data byte to the mouse; 0xF4 starts its
// movement reports. The mouse answers 0xFA, which arrives as a mouse byte.
fn keys_enable_mouse(pm: cap phys.mem) -> Unit {
  keys_wait_input_free(pm);
  unsafe {
    port_outb(0x64, 0xD4);
  }
  keys_wait_input_free(pm);
  unsafe {
    port_outb(0x60, 0xF4);
  }
  return;
}

fn app_init(pm: cap phys.mem) -> Unit {
  keys_status(pm, false);
  let start: Int = timer_now(pm);
  timer_wait_until(pm, start + KEYS_STALE_WINDOW_US);
  kbd_init(pm);
  keys_enable_mouse(pm);
  keys_last = 0;
  keys_status(pm, true);
  return;
}

// One poll. Returns 1 once Z, X and C are held together.
fn app_frame(pm: cap phys.mem) -> Int {
  kbd_poll(pm);
  let held: Int = kbd_state();
  let seen: Int = kbd_take_seen();
  let tapped: Int = seen & (~held);
  if (held != keys_last) {
    keys_line(pm, false, held);
    keys_last = held;
  }
  if (tapped != 0) {
    keys_line(pm, true, tapped);
  }
  if ((held & KEYS_QUIT) == KEYS_QUIT) {
    return 1;
  }
  return 0;
}
