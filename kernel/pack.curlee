// SPDX-License-Identifier: GPL-3.0
//
// pack.curlee — pure, verifiable glyph-layout helpers for the VGA text
// framebuffer. This module is freestanding-compatible (Int/Bool only, no
// Phys, no String/Vec/print), so it type-checks, verifies, and can be run
// under the VM for tests — but the kernel calls these directly, so the
// "packer" is a deterministic function of (char, attr, column) -> cell value
// and (column) -> buffer address.
//
// Curlee constraints (verified against the compiler):
//   - Operators: + - * /, comparisons, && || !. NO shifts, NO modulo,
//     NO bitwise ops.
//   - Hex literals like 0xB8000 are ONLY valid inside phys<U32>(...); normal
//     Int expressions use decimal.
//   - NO `else if` chain — use nested if/else blocks.
//
// Design: the kernel renders "Hello World from Curlee" to the 80x25 VGA text
// buffer (base 0xB8000, 2 bytes/cell: char, attribute). This module provides
// the pure mappings used by the kernel:
//
//   1. vga_cell(ch, attr)     -> the packed 2-byte cell value.
//   2. vga_addr(col)          -> the physical byte address of a column in row 0.
//
// These are Int -> Int, total, and verified.

// Pack (char, attribute) into the 2-byte VGA cell value:
//   low byte  = ASCII character
//   high byte = attribute (foreground | background << 4)
fn vga_cell(ch: Int, attr: Int) -> Int {
  return ch + attr * 256;
}

// Byte address of column `col` in text row 0 (VGA base 0xB8000, 2 bytes/cell).
// 0xB8000 = 753664 decimal.
fn vga_addr(col: Int) -> Int {
  return 753664 + col * 2;
}

// True when a column is within the 80-column text width.
fn valid_col(col: Int) -> Bool {
  return col >= 0 && col < 80;
}

// The ASCII codes for "Hello World from Curlee".
static hello: [Int; 24] = [0; 24];

fn hello_char_at(i: Int) -> Int {
  hello[0] = 72;
  hello[1] = 101;
  hello[2] = 108;
  hello[3] = 108;
  hello[4] = 111;
  hello[5] = 32;
  hello[6] = 87;
  hello[7] = 111;
  hello[8] = 114;
  hello[9] = 108;
  hello[10] = 100;
  hello[11] = 32;
  hello[12] = 102;
  hello[13] = 114;
  hello[14] = 111;
  hello[15] = 109;
  hello[16] = 32;
  hello[17] = 67;
  hello[18] = 117;
  hello[19] = 114;
  hello[20] = 108;
  hello[21] = 101;
  hello[22] = 101;
  hello[23] = 0;
  return hello[i];
}

// The message length ("Hello World from Curlee" = 23 characters).
fn hello_len() -> Int {
  return 23;
}

// Test entry (not part of the kernel build; `curlee run pack.curlee`).
// vga_cell('H'=72, attr=0x0F) == 0x0F48 = 3912; vga_addr(0) == 753664.
// hello_char_at(0) == 'H' = 72; hello_char_at(22) == 'e' = 101 (last real
// char of "Hello World from Curlee", index 22 of 23).
fn main() -> Int {
  if (vga_cell(72, 15) != 3912) {
    return 1;
  }
  if (hello_char_at(0) != 72) {
    return 2;
  }
  if (hello_char_at(22) != 101) {
    return 3;
  }
  return 0;
}
