// SPDX-License-Identifier: GPL-3.0
//
// Pure sector-range bounds helpers for virtio-blk sector reads.
//
// A read request reads `count` 512-byte sectors starting at LBA `sector` on
// a device with `capacity` total sectors. The read is in bounds iff:
//   sector >= 0 AND count > 0 AND sector + count <= capacity
// These helpers let the driver validate a request before queueing it.
// Pure library: no Phys, no unsafe, no extern, no imports.

// Whether a read of `count` sectors at LBA `sector` fits within a device of
// `capacity` sectors.
fn vblk_read_in_bounds(sector: Int, count: Int, capacity: Int) -> Bool
  [ requires true; ensures result == (sector >= 0 && count > 0 && sector + count <= capacity); ] {
  return sector >= 0 && count > 0 && sector + count <= capacity;
}

// The first sector index after a read of `count` sectors starting at `sector`.
fn vblk_sector_after(sector: Int, count: Int) -> Int
  [ requires sector >= 0 && count >= 0; ensures result == sector + count; ] {
  return sector + count;
}

// The last sector index (0-based, inclusive) of a read of `count` sectors
// starting at `sector`.
fn vblk_last_sector(sector: Int, count: Int) -> Int
  [ requires sector >= 0 && count > 0; ensures result == sector + count - 1; ] {
  return sector + count - 1;
}
