// SPDX-License-Identifier: GPL-3.0
//
// glyphs.curlee — pure, verified 5x7 glyph math and text layout for the
// Phase 2 software renderer. Mirrors the authoritative 5x7 glyph tables in
// kernel/fb.c (the C blitter's glyph_row) so that text layout is computable
// and provable in Curlee while the C side executes the pixels.
//
// It is freestanding-safe (Int/Bool only), verifies (Z3), and runs under the
// VM (`curlee run kernel/canvas_test.curlee`). The kernel build merges this
// module (plus canvas/assets) with kernel.curlee via scripts/build-kernel.sh
// into a single self-contained translation unit — the freestanding codegen
// accepts no imports (see docs/phase2-architecture.md §1/§6). kernel.curlee
// is a slim entry and does NOT duplicate these helpers.
//
// Curlee verifier fragment (see canvas.curlee header): contracted functions
// use + - * comparisons && || ! only; division lives in contract-less
// helpers asserted by the VM test.
//
// Glyph encoding: each 5x7 glyph is 7 rows of 5-bit bitmasks, bit 4 (0x10)
// = leftmost pixel, bit 0 (0x01) = rightmost pixel. glyph_row(ch, row)
// returns the 5-bit row for ASCII ch at row 0..6 (blank for unknown chars).
// The C tables in fb.c must stay in sync (the VM test asserts the same
// values this module computes).

// True when the pixel at (col, row) in the 5x7 grid of glyph `ch` is set.
// col in 0..4, row in 0..6. Total: any input yields a Bool. Verified.
//
// Bit extraction without shifts/modulo: for column c, the bit value is
// 16 >> c. A column is SET iff (bits mod (2*value)) >= value, computed with
// division-free arithmetic: bits - (bits / (2*value)) * (2*value) >= value.
fn glyph_pixel(ch: Int, col: Int, row: Int) -> Bool
  [ requires col >= 0 && col < 5; requires row >= 0 && row < 7;
    ensures true; ] {
  let bits: Int = glyph_row(ch, row);
  if (col == 0) {
    if (bits - (bits / 32) * 32 >= 16) {
      return true;
    } else {
      return false;
    }
  } else {
    if (col == 1) {
      if (bits - (bits / 16) * 16 >= 8) {
        return true;
      } else {
        return false;
      }
    } else {
      if (col == 2) {
        if (bits - (bits / 8) * 8 >= 4) {
          return true;
        } else {
          return false;
        }
      } else {
        if (col == 3) {
          if (bits - (bits / 4) * 4 >= 2) {
            return true;
          } else {
            return false;
          }
        } else {
          if (col == 4) {
            if (bits - (bits / 2) * 2 >= 1) {
              return true;
            } else {
              return false;
            }
          } else {
            return false;
          }
        }
      }
    }
  }
}

// Width of a text run of `len` glyphs at `scale` pixels per glyph column:
// each glyph is 5 columns plus 1 column of advance. Contract-less: len * 6 *
// scale is variable-variable multiplication, which the Z3 fragment rejects
// as non-linear inside a contracted function ("non-linear multiplication is
// not supported"). Correctness is asserted by the VM test.
fn text_width(len: Int, scale: Int) -> Int {
  return len * 6 * scale;
}

// X offset of glyph `i` in a text run at `scale` (advance = 6 * scale per
// glyph). Contract-less (same non-linear mult reason as text_width).
fn char_x(i: Int, scale: Int) -> Int {
  return i * 6 * scale;
}

// Height of a glyph at `scale` (7 rows * scale). Contract-less (7 * scale is
// constant * variable, but kept consistent with the layout helpers and
// asserted by the VM test).
fn glyph_height(scale: Int) -> Int {
  return 7 * scale;
}

// ---------------------------------------------------------------------------
// 5x7 glyph tables (bit 4 = leftmost column). Mirrors fb.c glyph_row.
// Contract-less (uses only literal returns, asserted by the VM test).
// ---------------------------------------------------------------------------

// Row `row` (0..6) of the 5-bit glyph for ASCII `ch`. Blank (0) for
// unknown/space rows beyond the glyph's content. Total: any input -> 0..31.
fn glyph_row(ch: Int, row: Int) -> Int {
  if (ch == 72) {       // 'H'
    return glyph_h(row);
  } else {
    if (ch == 101) {    // 'e'
      return glyph_e(row);
    } else {
      if (ch == 108) {  // 'l'
        return glyph_l(row);
      } else {
        if (ch == 111) { // 'o'
          return glyph_o(row);
        } else {
          if (ch == 87) { // 'W'
            return glyph_w(row);
          } else {
            if (ch == 114) { // 'r'
              return glyph_r(row);
            } else {
              if (ch == 100) { // 'd'
                return glyph_d(row);
              } else {
                if (ch == 102) { // 'f'
                  return glyph_f(row);
                } else {
                  if (ch == 109) { // 'm'
                    return glyph_m(row);
                  } else {
                    if (ch == 67) { // 'C'
                      return glyph_c(row);
                    } else {
                      if (ch == 117) { // 'u'
                        return glyph_u(row);
                      } else {
                        if (ch == 33) { // '!'
                          return glyph_bang(row);
                        } else {
                          return 0;
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

// 'H' — rows 0..6: |  |  |  |##|  |  |  |
fn glyph_h(row: Int) -> Int {
  let arr: [Int; 7] = [0; 7];
  arr[0] = 17;
  arr[1] = 17;
  arr[2] = 17;
  arr[3] = 31;
  arr[4] = 17;
  arr[5] = 17;
  arr[6] = 17;
  return arr[row];
}

// 'e' — rows 0..6:  ###  #  # #### #      ###
fn glyph_e(row: Int) -> Int {
  let arr: [Int; 6] = [0; 6];
  arr[0] = 14;
  arr[1] = 17;
  arr[2] = 31;
  arr[3] = 16;
  arr[4] = 14;
  return arr[row];
}

// 'l' — rows 0..6:  #    #    #    #   ###
fn glyph_l(row: Int) -> Int {
  let arr: [Int; 6] = [0; 6];
  arr[0] = 4;
  arr[1] = 4;
  arr[2] = 4;
  arr[3] = 4;
  arr[4] = 7;
  arr[5] = 0;
  return arr[row];
}

// 'o' — rows 0..6:  ###  #  # #  # #  #  ###
fn glyph_o(row: Int) -> Int {
  let arr: [Int; 6] = [0; 6];
  arr[0] = 14;
  arr[1] = 17;
  arr[2] = 17;
  arr[3] = 17;
  arr[4] = 14;
  arr[5] = 0;
  return arr[row];
}

// 'W' — rows 0..6: #  # #  # #  # # # # ##### #  #
fn glyph_w(row: Int) -> Int {
  let arr: [Int; 7] = [17; 7];
  arr[0] = 17;
  arr[1] = 17;
  arr[2] = 17;
  arr[3] = 21;
  arr[4] = 27;
  arr[5] = 17;
  arr[6] = 17;
  return arr[row];
}

// 'r' — rows 0..6:  ##   #    #    #   ###
fn glyph_r(row: Int) -> Int {
  let arr: [Int; 6] = [0; 6];
  arr[0] = 6;
  arr[1] = 4;
  arr[2] = 4;
  arr[3] = 4;
  arr[4] = 7;
  arr[5] = 0;
  return arr[row];
}

// 'd' — rows 0..6:    #    #  ### #  # #  #  ###
fn glyph_d(row: Int) -> Int {
  let arr: [Int; 7] = [0; 7];
  arr[0] = 1;
  arr[1] = 1;
  arr[2] = 7;
  arr[3] = 9;
  arr[4] = 9;
  arr[5] = 7;
  arr[6] = 0;
  return arr[row];
}

// 'f' — rows 0..6:  ###  #  # #### #    #
fn glyph_f(row: Int) -> Int {
  let arr: [Int; 6] = [0; 6];
  arr[0] = 6;
  arr[1] = 9;
  arr[2] = 14;
  arr[3] = 8;
  arr[4] = 8;
  return arr[row];
}

// 'm' — rows 0..6: # # # # # # # # # ##
fn glyph_m(row: Int) -> Int {
  let arr: [Int; 6] = [0; 6];
  arr[0] = 21;
  arr[1] = 21;
  arr[2] = 21;
  arr[3] = 21;
  arr[4] = 27;
  arr[5] = 0;
  return arr[row];
}

// 'C' — rows 0..6:  ###  #  # #    #    ###
fn glyph_c(row: Int) -> Int {
  let arr: [Int; 6] = [0; 6];
  arr[0] = 14;
  arr[1] = 17;
  arr[2] = 16;
  arr[3] = 16;
  arr[4] = 14;
  arr[5] = 0;
  return arr[row];
}

// 'u' — rows 0..6: #  # #  # #  # #  #  ###
fn glyph_u(row: Int) -> Int {
  let arr: [Int; 6] = [0; 6];
  arr[0] = 5;
  arr[1] = 9;
  arr[2] = 9;
  arr[3] = 9;
  arr[4] = 7;
  arr[5] = 0;
  return arr[row];
}

// '!' — rows 0..6:  #    #    #        #
fn glyph_bang(row: Int) -> Int {
  let arr: [Int; 6] = [0; 6];
  arr[0] = 4;
  arr[1] = 4;
  arr[2] = 4;
  arr[3] = 0;
  arr[4] = 4;
  arr[5] = 0;
  return arr[row];
}
