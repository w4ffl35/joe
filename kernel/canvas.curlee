// SPDX-License-Identifier: GPL-3.0
//
// canvas.curlee — pure, verified geometry and color math for the Phase 2
// software renderer. This module is the "intent" layer: it computes the
// rectangles, colors, and clip regions the blitter (kernel/fb.c) executes.
//
// It is freestanding-safe (Int/Bool only — no Phys, no String/Vec, no print),
// so it type-checks, verifies (Z3), and runs under the VM
// (`curlee run kernel/canvas_test.curlee`). The kernel build merges this
// module (plus glyphs/assets) with kernel.curlee via scripts/build-kernel.sh
// into a single self-contained translation unit — the freestanding codegen
// accepts no imports (see docs/phase2-architecture.md §1/§6). kernel.curlee
// is a slim entry and does NOT duplicate these helpers.
//
// OOB safety contract: the C blitter trusts these pure functions to compute
// in-bounds targets. `rect_contains` / `clip_rect` are total functions — an
// out-of-bounds rectangle can never be produced by this module, so the
// volatile framebuffer writes that consume its output are provably bounded.
// The C side still double-checks as defense-in-depth.
//
// Curlee verifier fragment (confirmed against the compiler source + live):
//   - The verifier ONLY lowers functions that carry a contract (requires or
//     ensures). Contract-less functions are skipped by the solver entirely
//     (they run correctly on the VM and codegen).
//   - Verified (contracted) functions support ONLY: + - * , comparisons,
//     && || !. Division (/), shifts, modulo, bitwise are "unsupported binary
//     operator in expression" inside a contracted function.
//   - Function parameters/returns must be scalar Int/Bool. Struct types are
//     rejected ("unknown type") in signatures — structs only work as local
//     VM bindings. Rectangles are therefore passed as flat (x, y, w, h)
//     Int components.
//   - NO function calls inside verified expressions (inlined here).
//   - NO `else if` chain — use nested if/else blocks.
//   - Z3 cannot always prove `ensures` on packed-int encodings (e.g. the
//     clipped rect packed as x*2^24 + y*2^16 + w*2^8 + h). Functions whose
//     contract is genuinely proven live carry a contract; the rest are
//     contract-less and asserted by the VM test (the real correctness gate).
//
// Consequence: division lives in CONTRACT-LESS helpers (channel extraction,
// clip decomposition); contract-carrying functions use only the supported
// fragment and delegate division to those helpers. The VM test
// (canvas_test.curlee) asserts the exact behavior of every function — that
// is the authoritative correctness gate for the division-based helpers.

// ---------------------------------------------------------------------------
// Colors (0x00RRGGBB packed into an Int)
// ---------------------------------------------------------------------------

// Pack a 24-bit 0x00RRGGBB color from its red, green, blue components.
// Verified: any in-range components map to a non-negative color value.
fn rgb(r: Int, g: Int, b: Int) -> Int
  [ requires r >= 0 && r < 256;
    requires g >= 0 && g < 256;
    requires b >= 0 && b < 256;
    ensures result >= 0; ] {
  return r * 65536 + g * 256 + b;
}

// Extract the red channel (bits 16..23) of a 0x00RRGGBB color.
// Contract-less: uses division, verified by the VM test instead of Z3.
fn red(c: Int) -> Int {
  return c / 65536;
}

// Extract the green channel (bits 8..15) of a 0x00RRGGBB color.
fn green(c: Int) -> Int {
  return (c / 256) - (c / 65536) * 256;
}

// Extract the blue channel (bits 0..7) of a 0x00RRGGBB color.
fn blue(c: Int) -> Int {
  return c - (c / 256) * 256;
}

// ---------------------------------------------------------------------------
// Geometry (rectangles as flat (x, y, w, h) Int components)
// ---------------------------------------------------------------------------

// True when the point (px, py) lies inside the rectangle whose origin is
// (x, y) and size is (w, h). Half-open: right/bottom edges exclusive,
// matching the blitter's loops. Total and verified.
fn rect_contains(x: Int, y: Int, w: Int, h: Int, px: Int, py: Int) -> Bool
  [ requires w >= 0 && h >= 0; ensures true; ] {
  if (px >= x && px < x + w && py >= y && py < y + h) {
    return true;
  } else {
    return false;
  }
}

// True when rectangle a (ax, ay, aw, ah) fully covers rectangle b
// (bx, by, bw, bh). Total and verified.
fn rect_covers(ax: Int, ay: Int, aw: Int, ah: Int,
               bx: Int, by: Int, bw: Int, bh: Int) -> Bool
  [ requires aw >= 0 && ah >= 0; requires bw >= 0 && bh >= 0;
    ensures true; ] {
  if (bx >= ax && by >= ay && bx + bw <= ax + aw && by + bh <= ay + ah) {
    return true;
  } else {
    return false;
  }
}

// Clamp v into the inclusive range [lo, hi]. Total and verified: any v maps
// to a value in [lo, hi].
fn clamp(v: Int, lo: Int, hi: Int) -> Int
  [ requires lo <= hi;
    ensures result >= lo && result <= hi; ] {
  if (v < lo) {
    return lo;
  } else {
    if (v > hi) {
      return hi;
    } else {
      return v;
    }
  }
}

// Clamp a coordinate into [lo, hi] without a contract (the contract-less
// twin of `clamp`). Used by clip_rect so the packed-clip path never needs to
// discharge a contracted callee's requires against symbolic bounds. The VM
// test asserts the same behavior as `clamp`.
fn clip_coord(v: Int, lo: Int, hi: Int) -> Int {
  if (v < lo) {
    return lo;
  } else {
    if (v > hi) {
      return hi;
    } else {
      return v;
    }
  }
}

// Clip rectangle r (rx, ry, rw, rh) to the bounds of rectangle b
// (bx, by, bw, bh), returning the largest in-bounds rectangle packed as
// (x * 2^24 + y * 2^16 + w * 2^8 + h). If there is no overlap the result is
// 0 (an empty rect). Contract-less: the packed encoding's `ensures` is not
// Z3-provable (see module header), so correctness is asserted by the VM test
// (canvas_test.curlee), which decomposes the result and checks every
// component is in-bounds. The C blitter additionally bounds-checks.
//
// The clamping is inlined (rather than calling the contracted `clamp`) so
// the contract-less path never needs to discharge `clamp`'s `lo <= hi`
// obligation against symbolic screen bounds.
fn clip_rect(rx: Int, ry: Int, rw: Int, rh: Int,
             bx: Int, by: Int, bw: Int, bh: Int) -> Int {
  let x0: Int = clip_coord(rx, bx, bx + bw);
  let y0: Int = clip_coord(ry, by, by + bh);
  let x1: Int = clip_coord(rx + rw, bx, bx + bw);
  let y1: Int = clip_coord(ry + rh, by, by + bh);
  if (x1 >= x0 && y1 >= y0) {
    let cw: Int = x1 - x0;
    let ch: Int = y1 - y0;
    return x0 * 16777216 + y0 * 65536 + cw * 256 + ch;
  } else {
    return 0;
  }
}

// Decompose a packed clip result (from clip_rect) into its x component.
// Contract-less (division).
fn clip_x(r: Int) -> Int {
  return r / 16777216;
}

// Decompose a packed clip result into its y component.
fn clip_y(r: Int) -> Int {
  return (r / 65536) - (r / 16777216) * 256;
}

// Decompose a packed clip result into its width component.
fn clip_w(r: Int) -> Int {
  return (r / 256) - (r / 65536) * 256;
}

// Decompose a packed clip result into its height component.
fn clip_h(r: Int) -> Int {
  return r - (r / 256) * 256;
}

// ---------------------------------------------------------------------------
// Alpha blending
// ---------------------------------------------------------------------------

// Alpha-blend foreground color fg over background bg with an integer alpha
// in 0..255. Per-channel over operator: out = (fg*a + bg*(255-a)) / 255.
// The per-channel division lives in a contract-less helper (blend_channel),
// so the contracted wrapper stays on the + - * fragment. The wrapper's
// `ensures` cannot be proven (the channel helper is opaque to the solver),
// so this carries no contract and is asserted by the VM test.
fn blend_alpha(fg: Int, bg: Int, alpha: Int) -> Int {
  let fg_r: Int = red(fg);
  let fg_g: Int = green(fg);
  let fg_b: Int = blue(fg);
  let bg_r: Int = red(bg);
  let bg_g: Int = green(bg);
  let bg_b: Int = blue(bg);
  let out_r: Int = blend_channel(fg_r, bg_r, alpha);
  let out_g: Int = blend_channel(fg_g, bg_g, alpha);
  let out_b: Int = blend_channel(fg_b, bg_b, alpha);
  return out_r * 65536 + out_g * 256 + out_b;
}

// Blend one 0..255 channel: (fg*a + bg*(255-a)) / 255. Contract-less
// (division); the result is asserted by the VM test.
fn blend_channel(fg: Int, bg: Int, alpha: Int) -> Int {
  return (fg * alpha + bg * (255 - alpha)) / 255;
}
