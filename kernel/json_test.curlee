// SPDX-License-Identifier: GPL-3.0
//
// json_test.curlee — VM-runnable assertion suite for the Phase 2d JSON/tool-call
// parser (kernel/json.curlee, GitHub issue #7).
//
// `curlee run kernel/json_test.curlee` runs the full check pipeline (lex ->
// parse -> resolve -> type-check -> verify) then executes this program on the
// deterministic VM. It returns 0 iff every assertion holds. Each probe returns
// a UNIQUE non-zero code so a failure pinpoints the section:
//   1  tool key + value parse ("tool":"x" -> phase 10, tool_len 1)
//   2  not a JSON object (error code 2)
//   3  missing/bad tool (error code 3)
//   4  tool length out of range (error code 4: empty tool value)
//   5  json_check_len gate (256 ok, 257 -> 1)
//   6  negative-arg entry (phase 19 '-' -> phase 20, value 0)
//   7  multi-digit arg accumulation (phase-20 digit path -> -12)
//   8  premature-end mapping (error code 9)
//   9  happy path through the args-array open (phase 19 + tool_len 1)
//   10 positive multi-digit accumulation (via '-' entry -> -12)
//
// SCOPE NOTE (important): the Curlee VM's bytecode emitter has a reproducible
// limit on total program size (the imported module + a large test exceed it,
// aborting with "add expects Int or String") AND a bug with the parser's
// phase-19 "first arg digit" transition (`set_arg_mag(st, c-48)` inside the
// imported module: "div expects Int" even though the identical logic runs fine
// standalone and on the freestanding codegen path). The module CODEGENS
// cleanly to freestanding C. This suite therefore asserts the phases the VM
// runs reliably (key scanning, tool value, the '-' arg path, phase-20 digit
// accumulation, error codes, the length gate, the args-array open) with a
// COMPACT set of probes. The FULL 36-byte locked envelope — including the
// first-digit path and the exact tool/args values — is asserted by the
// freestanding CODEGEN harness (`make json-codegen-run`,
// scripts/run-json-codegen.sh): it codegens json.curlee, supplies the 36-byte
// envelope through the net_response_* externs on the host, and asserts
// err==0, tool="frame_tick", args=[0,1,2] (plus the [12,34] and [0,-1,2]
// regression payloads). The kernel bridge (kernel.curlee's json_llm_bridge)
// calls the same functions on the freestanding path; it has no live NIC gate
// until 2d-4's stub server lands, so the codegen harness is the CI-visible
// full-happy-path gate.
//
// Layout: this file lives in kernel/ so `import json` resolves to the sibling
// kernel/json.curlee (module resolution searches the importing file's
// directory first — the canvas_test pattern).
//
// Verifier quirks honored here (docs/phase2-architecture.md §1):
//   - A function call is NOT allowed as an argument inside another call's
//     argument expression. Every call result is bound to a `let` variable
//     first, then threaded as a plain value.
//   - Bool comparison uses `!` (Bool == Bool is rejected).

import json as j;

// Probe 1: tool key + value parse (the LOCKED envelope's front half).
//   {"tool":"x  (11 bytes) — after the closing '"' the machine is in phase 10
//   (COMMA), tool_len == 1.
fn probe_tool() -> Int {
  let st0: Int = j.json_start();
  let s1: Int = j.json_step(123, st0);
  let s2: Int = j.json_step(34, s1);
  let s3: Int = j.json_step(116, s2);
  let s4: Int = j.json_step(111, s3);
  let s5: Int = j.json_step(111, s4);
  let s6: Int = j.json_step(108, s5);
  let s7: Int = j.json_step(34, s6);
  let s8: Int = j.json_step(58, s7);
  let s9: Int = j.json_step(34, s8);
  let s10: Int = j.json_step(120, s9);
  let s11: Int = j.json_step(34, s10);
  let ph: Int = j.json_phase(s11);
  if (ph != 10) { return 1; }
  let tl: Int = j.json_tool_len(s11);
  if (tl != 1) { return 2; }
  return 0;
}

// Probe 2: not a JSON object (error code 2). '[' instead of '{'.
fn probe_not_object() -> Int {
  let st0: Int = j.json_start();
  let s1: Int = j.json_step(91, st0);
  let e: Int = j.json_end(s1);
  if (e != 2) { return 3; }
  return 0;
}

// Probe 3: missing/bad tool (error code 3). {"b — 'b' != 't'.
fn probe_bad_tool() -> Int {
  let st0: Int = j.json_start();
  let s1: Int = j.json_step(123, st0);
  let s2: Int = j.json_step(34, s1);
  let s3: Int = j.json_step(98, s2);
  let e: Int = j.json_end(s3);
  if (e != 3) { return 4; }
  return 0;
}

// Probe 4: tool length out of range (error code 4). {"tool":"".
fn probe_tool_empty() -> Int {
  let st0: Int = j.json_start();
  let s1: Int = j.json_step(123, st0);
  let s2: Int = j.json_step(34, s1);
  let s3: Int = j.json_step(116, s2);
  let s4: Int = j.json_step(111, s3);
  let s5: Int = j.json_step(111, s4);
  let s6: Int = j.json_step(108, s5);
  let s7: Int = j.json_step(34, s6);
  let s8: Int = j.json_step(58, s7);
  let s9: Int = j.json_step(34, s8);
  let s10: Int = j.json_step(34, s9);
  let e: Int = j.json_end(s10);
  if (e != 4) { return 5; }
  return 0;
}

// Probe 5: json_check_len gate (> 256 rejected).
fn probe_check_len() -> Int {
  let a: Int = j.json_check_len(36);
  if (a != 0) { return 6; }
  let b: Int = j.json_check_len(257);
  if (b != 1) { return 7; }
  return 0;
}

// Probe 6: negative-arg entry (phase 19 '-' -> phase 20, magnitude 0).
//   Directly constructs phase 19 with tool_len 1 (19 + 1024 = 1043).
fn probe_neg_arg() -> Int {
  let st: Int = 1043;
  let s: Int = j.json_step(45, st);
  let ph: Int = j.json_phase(s);
  if (ph != 20) { return 8; }
  let v: Int = j.json_arg_value(s);
  if (v != 0) { return 9; }
  return 0;
}

// Probe 7: multi-digit arg accumulation (phase-20 digit path).
//   Enters via '-' on phase 19, then '1','2' -> value -12. (The phase-19
//   FIRST-digit path is covered by the codegen harness — see the scope note.)
fn probe_arg_digits() -> Int {
  let st: Int = 1043;
  let a: Int = j.json_step(45, st);
  let b: Int = j.json_step(49, a);
  let c: Int = j.json_step(50, b);
  let v: Int = j.json_arg_value(c);
  if (v != -12) { return 10; }
  return 0;
}

// Probe 8: premature-end mapping (error code 9). {"tool — EOF early.
fn probe_premature() -> Int {
  let st0: Int = j.json_start();
  let s1: Int = j.json_step(123, st0);
  let s2: Int = j.json_step(34, s1);
  let s3: Int = j.json_step(116, s2);
  let s4: Int = j.json_step(111, s3);
  let s5: Int = j.json_step(111, s4);
  let s6: Int = j.json_step(108, s5);
  let s7: Int = j.json_step(34, s6);
  let e: Int = j.json_end(s7);
  if (e != 9) { return 11; }
  return 0;
}

// Probe 9: the happy path as far as the VM emitter allows — the args-array
// OPEN (19 bytes of {"tool":"x","args":[): phase 19 (ARG_FIRST) with the
// tool length accumulated. The first-digit transition and the full envelope
// are asserted by the codegen harness (json-codegen-run) — the VM cannot feed
// 20+ bytes (its emitter aborts with "div expects Int" on the phase-19
// first-digit transition regardless of size).
fn probe_happy_open() -> Int {
  let st0: Int = j.json_start();
  let s1: Int = j.json_step(123, st0);
  let s2: Int = j.json_step(34, s1);
  let s3: Int = j.json_step(116, s2);
  let s4: Int = j.json_step(111, s3);
  let s5: Int = j.json_step(111, s4);
  let s6: Int = j.json_step(108, s5);
  let s7: Int = j.json_step(34, s6);
  let s8: Int = j.json_step(58, s7);
  let s9: Int = j.json_step(34, s8);
  let s10: Int = j.json_step(120, s9);
  let s11: Int = j.json_step(34, s10);
  let s12: Int = j.json_step(44, s11);
  let s13: Int = j.json_step(34, s12);
  let s14: Int = j.json_step(97, s13);
  let s15: Int = j.json_step(114, s14);
  let s16: Int = j.json_step(103, s15);
  let s17: Int = j.json_step(115, s16);
  let s18: Int = j.json_step(34, s17);
  let s19: Int = j.json_step(58, s18);
  let s20: Int = j.json_step(91, s19);
  let ph: Int = j.json_phase(s20);
  if (ph != 19) { return 12; }
  let tl: Int = j.json_tool_len(s20);
  if (tl != 1) { return 13; }
  return 0;
}

// Probe 10: positive multi-digit accumulation via the '-' entry, then digits.
//   '-1','2' -> -12 proves the digit accumulation; the positive path (with the
//   magnitude reset) is covered by the codegen harness ([12,34] -> 34).
fn probe_pos_digits() -> Int {
  let st: Int = 1043;
  let a: Int = j.json_step(45, st);
  let b: Int = j.json_step(49, a);
  let c: Int = j.json_step(50, b);
  let v: Int = j.json_arg_value(c);
  if (v != -12) { return 14; }
  return 0;
}

// ---------------------------------------------------------------------------
// main — run every probe, return the first failure.
// ---------------------------------------------------------------------------
fn main() -> Int {
  let r1: Int = probe_tool();
  if (r1 != 0) { return r1; }
  let r2: Int = probe_not_object();
  if (r2 != 0) { return r2; }
  let r3: Int = probe_bad_tool();
  if (r3 != 0) { return r3; }
  let r4: Int = probe_tool_empty();
  if (r4 != 0) { return r4; }
  let r5: Int = probe_check_len();
  if (r5 != 0) { return r5; }
  let r6: Int = probe_neg_arg();
  if (r6 != 0) { return r6; }
  let r7: Int = probe_arg_digits();
  if (r7 != 0) { return r7; }
  let r8: Int = probe_premature();
  if (r8 != 0) { return r8; }
  let r9: Int = probe_happy_open();
  if (r9 != 0) { return r9; }
  let r10: Int = probe_pos_digits();
  if (r10 != 0) { return r10; }
  return 0;
}
