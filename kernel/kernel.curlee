// SPDX-License-Identifier: GPL-3.0
//
// kernel.curlee — Phase 2 entry: agentic framebuffer OS (renderer kernel).
//
// Boot path (chosen): qemu -kernel via the curlee freestanding toolchain.
//   - `curlee build --link` emits freestanding C from the MERGED file
//     (scripts/build-kernel.sh concatenates canvas.curlee + glyphs.curlee +
//     assets.curlee + this file into a single translation unit — the codegen
//     crashes on imports, see docs/phase2-architecture.md §1), compiles it
//     with -ffreestanding -fno-builtin -nostdlib, assembles runtime/crt0.S,
//     and links with runtime/linker.ld into a multiboot2+PVH kernel ELF.
//   - crt0.S (PVH entry) calls `curlee_main` (this file's `main`).
//
// THIS FILE IS NOT VERIFIED STANDALONE — it depends on the pure helpers from
// canvas/glyphs/assets (supplied at merge time). Verify the merged file
// (`make check`) or the individual modules (`curlee check kernel/canvas.curlee`).
//
// Display strategy (Phase 2): a software renderer targeting the UEFI/linear
// framebuffer. Curlee computes geometry/intent (pure, verified); the C driver
// (kernel/fb.c) executes pixels. When the framebuffer is available
// (fb_ready() == 1) the kernel renders the declarative demo scene via
// render_frame(); otherwise it falls back to the VGA text buffer (QEMU).
//
// Design laws honored:
//   - Single address space, Ring 0: direct volatile stores via Phys<T>/fb.c.
//   - Deterministic verification: the pure geometry (canvas/glyphs/assets) is
//     Z3-verified and VM-tested (kernel/canvas_test.curlee); no proof, no build.
//   - Minimal footprint: no libc, no malloc, no String/Vec; the C driver owns
//     mutable blitter state; Curlee owns pure math + declarative scenes.

// NOTE: there is NO `extern fn curlee_putc` here — since issue #9 the COM1
// serial driver is a genuine Curlee function (`putc` in serial.curlee, merged
// in below). The codegen emits it as the static symbol `curlee_putc`, the
// same weak-hook name the runtime's rt.c reserves; the extern declaration was
// removed because a C extern and a static definition of the same identifier
// cannot coexist in one translation unit.
extern fn curlee_halt() -> Unit;

// gh issue #13: the ENTIRE framebuffer blitter + 60 FPS event loop moved to
// genuine Curlee (kernel/fb.curlee, merged in before this file) — the
// fb_wire_draw_target / fb_ready / fb_clear / fb_pixel / fb_fill_rect /
// fb_line / fb_blit_asset / fb_present / fb_get_width / fb_get_height /
// fb_ring_active / fb_ring_slot / fb_asset_region_w/h/base / fb_loop_init /
// fb_loop_frame / fb_tool_enqueue / fb_tool_drained / fb_tool_pending /
// fb_run_loop externs are GONE (the codegen emits them as curlee_fb_* static
// symbols). kernel/fb.c is now only the raw-state + memory-move shim
// (globals, the static ring/region arrays, phys_write_u32/fb_mem_read_u32/
// fb_pvh_build) that the Curlee blitter reads/writes through the extern
// window declared in fb.curlee — this file declares NO fb_* externs at all.
// main gates the ring loop on fb_asset_region_w()==0 below — the PVH/GRUB
// discriminator (fb_pvh_build in the shim).

// Phase 2d-1/2d-2 — VirtIO-net + TCP/IP stack extern surface. Declared in
// kernel/net_glue.curlee (merged in before this file by
// scripts/build-kernel.sh — the merged TU forbids duplicate externs, so they
// live exactly once, next to the one-shot glue that consumes them:
// net_connect / net_send / net_stack_poll / net_response_len /
// net_response_byte are genuine Curlee functions there, gh issue #12). The
// pure protocol core is kernel/net_stack.curlee (extern-free); the C shim is
// kernel/net_stack.c (raw state + response byte store only).

// ===========================================================================
// Phase 2 declarative render scene (called per-frame by fb_run_loop's C loop)
// ===========================================================================

// Serial fallback: emit the message via the ported COM1 driver — serial.curlee's
// `putc` (codegen'd as the static `curlee_putc` symbol, the runtime's weak-hook
// name) — so the boot is observable. QEMU captures it with `-serial file:...`
// / `-serial stdio`.
fn serial_hello(pm: cap phys.mem) -> Unit {
  putc(pm, 72);   // H
  putc(pm, 101);  // e
  putc(pm, 108);  // l
  putc(pm, 108);  // l
  putc(pm, 111);  // o
  putc(pm, 32);   // space
  putc(pm, 87);   // W
  putc(pm, 111);  // o
  putc(pm, 114);  // r
  putc(pm, 108);  // l
  putc(pm, 100);  // d
  putc(pm, 32);   // space
  putc(pm, 102);  // f
  putc(pm, 114);  // r
  putc(pm, 111);  // o
  putc(pm, 109);  // m
  putc(pm, 32);   // space
  putc(pm, 74);   // J
  putc(pm, 79);   // O
  putc(pm, 69);   // E
  putc(pm, 33);   // !
  putc(pm, 10);   // newline
  return;
}

// ---------------------------------------------------------------------------
// Glyph text rendering (was fb.c's fb_draw_char_color)
// ---------------------------------------------------------------------------
//
// The 5x7 glyph tables are authoritative in glyphs.curlee (pure, VM-asserted).
// draw_glyph reads each glyph pixel via glyph_pixel (contract-less — the
// caller renders an already-gated box, so no in-bounds obligation) and drives
// fb_pixel per set pixel. The per-pixel loop is replaced by bounded recursion
// over the immutable (row, col) index — the established no-assignment pattern
// (see json_feed above). The caller must gate the (5*scale x 7*scale) bounding
// box with char_fits_gate before calling.
// Additive pixel-address recursion (NO col*scale / row*scale multiplication —
// variable*variable mult is rejected by the verifier; see canvas.curlee header).
// px = x + col*scale, py = y + row*scale are accumulated by adding `scale`
// per step, so every pixel address is a sum of the base (x, y) and a known
// offset (x is a caller-supplied scalar, so x + k is linear).
//
// The recursion is bounded and total: col runs 0..5 (5 columns), row runs
// 0..7 (7 rows), and the scale x scale block runs dx/dy 0..scale. The verifier
// treats the contract-less callers as opaque, so the pixel addresses and the
// glyph_pixel requires are guarded by explicit full-range checks (the verifier
// is path-sensitive: it picks up `col >= 0 && col < 5` etc. from the guards).
fn draw_glyph_px(ch: Int, x: Int, y: Int, scale: Int, color: Int,
                 row: Int, col: Int) -> Unit {
  if (row < 0 || row >= 7) {
    return;
  } else {
    if (col < 0 || col >= 5) {
      return;
    } else {
      // Guard the glyph_pixel requires (0 <= col < 5, 0 <= row < 7) explicitly
      // so the verifier can discharge them from the branch facts.
      let row_ok: Bool = row >= 0 && row < 7;
      let col_ok: Bool = col >= 0 && col < 5;
      if (row_ok && col_ok) {
        let on: Bool = glyph_pixel(ch, col, row);
        if (on) {
          // Top-left of the scale x scale block: px = x + col*scale.
          let px0: Int = x + col * scale;
          let py0: Int = y + row * scale;
          fb_pixel(px0, py0, color);
          draw_glyph_block(ch, x, y, scale, color, row, col, 0, 1);
        }
        // Advance to the next column (immutable index recursion).
        draw_glyph_px(ch, x, y, scale, color, row, col + 1);
      } else {
        return;
      }
    }
  }
}

// The scale x scale block of glyph pixel (row, col): draw each (dx, dy) cell.
// px = x + col*scale + dx is accumulated additively (x + col*scale is a
// constant base per pixel, then + dx).
fn draw_glyph_block(ch: Int, x: Int, y: Int, scale: Int, color: Int,
                    row: Int, col: Int, dx: Int, dy: Int) -> Unit {
  if (dy >= scale) {
    return;
  } else {
    if (dx >= scale) {
      // Next row of the block.
      draw_glyph_block(ch, x, y, scale, color, row, col, 0, dy + 1);
    } else {
      // (0,0) was already drawn by the caller; skip it here.
      if (dx == 0 && dy == 0) {
        draw_glyph_block(ch, x, y, scale, color, row, col, 1, 0);
      } else {
        // px = x + col*scale + dx — same linear form as draw_glyph_px.
        let px1: Int = x + col * scale + dx;
        let py1: Int = y + row * scale + dy;
        fb_pixel(px1, py1, color);
        draw_glyph_block(ch, x, y, scale, color, row, col, dx + 1, dy);
      }
    }
  }
}

// Draw one 5x7 glyph at (x, y) scaled by `scale` in `color`. Requires the
// caller to have gated the bounding box (char_fits_gate). Contract-less:
// the recursion bounds (row/col < 7/5) are enforced by the immutable-index
// recursion above, matching the total-function style of glyph_row.
fn draw_glyph(ch: Int, x: Int, y: Int, scale: Int, color: Int) -> Unit {
  draw_glyph_px(ch, x, y, scale, color, 0, 0);
  return;
}

// Framebuffer-acquired marker for the Phase 2e-2 acceptance gate
// (make qemu-fb-smoke): "FB: 1" proves fb_ready()==1 — the multiboot2
// framebuffer tag captured by the 32-bit boot stub was parsed and the linear
// framebuffer is active. The gate greps the serial log for "FB:".
fn serial_fb_marker(pm: cap phys.mem) -> Unit {
  putc(pm, 70);   // F
  putc(pm, 66);   // B
  putc(pm, 58);   // :
  putc(pm, 32);   // space
  putc(pm, 49);   // 1 (fb_ready() == 1)
  putc(pm, 10);   // newline
  return;
}

// Serial per-frame marker for the Phase 2b loop gate (make qemu-loop-smoke):
// "FR:<n>" proves the loop advanced past frame 1. `n` must be a single digit
// (the loop is fuel-bounded well under 10), so the marker is 6 chars + \n.
fn serial_frame_marker(pm: cap phys.mem, n: Int) -> Unit {
  putc(pm, 70);   // F
  putc(pm, 82);   // R
  putc(pm, 58);   // :
  putc(pm, 48 + n);   // digit n (0..9)
  putc(pm, 10);   // newline
  return;
}

// Phase 2c marker: "RING: 1" proves the frame ring is active — fb_present()
// performed a REAL back-buffer flip (ring_active == 1) during the loop. The
// marker is emitted after the loop when fb_ring_active() reports the ring
// flipped at least once. Grepped by the qemu-fb-smoke gate alongside "FB:".
fn serial_ring_marker(pm: cap phys.mem) -> Unit {
  putc(pm, 82);   // R
  putc(pm, 73);   // I
  putc(pm, 78);   // N
  putc(pm, 71);   // G
  putc(pm, 58);   // :
  putc(pm, 32);   // space
  putc(pm, 49);   // 1 (ring active)
  putc(pm, 10);   // newline
  return;
}

// Phase 2d-1 markers (docs/phase2d-wire.md §5): "NET: <n>" proves the
// VirtIO-net bring-up step n passed (1 = PCI found, 2 = device ready, 3 =
// link up). `n` is a single digit (1..3), so the marker is 6 chars + \n.
// Grepped in order by the qemu-net-smoke gate.
fn serial_net_marker(pm: cap phys.mem, n: Int) -> Unit {
  putc(pm, 78);   // N
  putc(pm, 69);   // E
  putc(pm, 84);   // T
  putc(pm, 58);   // :
  putc(pm, 32);   // space
  putc(pm, 48 + n);   // digit n (1..3)
  putc(pm, 10);   // newline
  return;
}

// Phase 2d-1 RX marker: "RX: <len>" reports the received frame length (the
// slirp ARP reply, 42-60 bytes — two digits max). No modulo (rejected by the
// compiler): split tens/ones with division + subtraction.
fn serial_rx_marker(pm: cap phys.mem, len: Int) -> Unit {
  putc(pm, 82);   // R
  putc(pm, 88);   // X
  putc(pm, 58);   // :
  putc(pm, 32);   // space
  let tens: Int = len / 10;
  let ones: Int = len - tens * 10;
  putc(pm, 48 + tens);
  putc(pm, 48 + ones);
  putc(pm, 10);   // newline
  return;
}

// Phase 2d-2 markers (docs/phase2d-wire.md §5): the TCP/IP stack hop markers.
//   ARP: 1  net_connect() resolved the gateway 10.0.2.2 -> MAC
//   TCP: 1  the same call completed the handshake (SYN -> SYN-ACK -> ACK)
//   SND: 36 net_send() queued the fixed 36-byte HTTP request
//   RCV: 36 net_stack_poll() finished receiving the response body
// `n` is a single digit (0..9) and `len` up to two digits (36 max).
fn serial_arp_marker(pm: cap phys.mem, n: Int) -> Unit {
  putc(pm, 65);   // A
  putc(pm, 82);   // R
  putc(pm, 80);   // P
  putc(pm, 58);   // :
  putc(pm, 32);   // space
  putc(pm, 48 + n);
  putc(pm, 10);   // newline
  return;
}

fn serial_tcp_marker(pm: cap phys.mem, n: Int) -> Unit {
  putc(pm, 84);   // T
  putc(pm, 67);   // C
  putc(pm, 80);   // P
  putc(pm, 58);   // :
  putc(pm, 32);   // space
  putc(pm, 48 + n);
  putc(pm, 10);   // newline
  return;
}

fn serial_snd_marker(pm: cap phys.mem, len: Int) -> Unit {
  putc(pm, 83);   // S
  putc(pm, 78);   // N
  putc(pm, 68);   // D
  putc(pm, 58);   // :
  putc(pm, 32);   // space
  let tens: Int = len / 10;
  let ones: Int = len - tens * 10;
  putc(pm, 48 + tens);
  putc(pm, 48 + ones);
  putc(pm, 10);   // newline
  return;
}

fn serial_rcv_marker(pm: cap phys.mem, len: Int) -> Unit {
  putc(pm, 82);   // R
  putc(pm, 67);   // C
  putc(pm, 86);   // V
  putc(pm, 58);   // :
  putc(pm, 32);   // space
  let tens: Int = len / 10;
  let ones: Int = len - tens * 10;
  putc(pm, 48 + tens);
  putc(pm, 48 + ones);
  putc(pm, 10);   // newline
  return;
}

// Phase 2d-4 markers (docs/phase2d-wire.md §5): the LLM bridge tail.
//   TOOL: 2  fb_tool_enqueue(2, arg) succeeded — the parsed tool call entered
//            the 2b tool-call queue (kind 2 = "LLM tool call", the 2d-3
//            contract)
//   LLM: 1   the acknowledgment frame was rendered (the serial marker is the
//            gate's ack; the visual "LLM OK" frame is a bonus on the fb path)
// `n` is a single digit (0..9), so each marker is 6-7 chars + \n.
fn serial_tool_marker(pm: cap phys.mem, n: Int) -> Unit {
  putc(pm, 84);   // T
  putc(pm, 79);   // O
  putc(pm, 79);   // O
  putc(pm, 76);   // L
  putc(pm, 58);   // :
  putc(pm, 32);   // space
  putc(pm, 48 + n);
  putc(pm, 10);   // newline
  return;
}

fn serial_llm_marker(pm: cap phys.mem, n: Int) -> Unit {
  putc(pm, 76);   // L
  putc(pm, 76);   // L
  putc(pm, 77);   // M
  putc(pm, 58);   // :
  putc(pm, 32);   // space
  putc(pm, 48 + n);
  putc(pm, 10);   // newline
  return;
}

// Phase 2d-1: VirtIO-net bring-up — probe, init, link, then the deterministic
// RX smoke path (the guest ARPs the slirp gateway 10.0.2.2; slirp auto-answers,
// delivering the first RX frame). Every step is gated on the previous step's
// return, so a missing NIC emits nothing and existing gates (which boot
// WITHOUT -netdev) stay green — acceptance criterion 6 (no-NIC-safe).
fn net_bringup(pm: cap phys.mem) -> Unit {
  let p: Int = net_probe();
  if (p == 1) {
    serial_net_marker(pm, 1);
    let i: Int = net_init();
    if (i == 1) {
      serial_net_marker(pm, 2);
      let l: Int = net_link_up();
      if (l == 1) {
        serial_net_marker(pm, 3);
        // Deterministic frame source (LOCKED): guest ARPs the gateway, slirp
        // answers automatically — the first RX frame, no host-side injection.
        let sent: Int = net_arp_request_gateway();
        let rlen: Int = net_rx_wait();
        if (rlen > 0) {
          serial_rx_marker(pm, rlen);
          net_rx_done();
        }
      }
    }
  }
  return;
}

// ---------------------------------------------------------------------------
// Phase 2d-2: the one-shot TCP/IP stack GLUE lives in kernel/net_glue.curlee
// (gh issue #12) — genuine Curlee net_connect / net_send / net_stack_poll /
// net_response_len / net_response_byte replacing the C externs, plus the
// whole 2d-1 + 2d-2 extern surface declared there exactly once (the merged
// TU forbids duplicate externs). The pure protocol byte math is
// kernel/net_stack.curlee; the raw state + response store is the
// kernel/net_stack.c shim. The round-trip below calls the glue functions
// exactly as it called the old C externs.
// ---------------------------------------------------------------------------

// Phase 2d-2: the TCP/IP stack round-trip (docs/phase2d-wire.md §5). Gated on
// the NIC bring-up succeeding (NET: 1..3), so the no-NIC-safe baseline stays
// green — with no virtio-net device every net_* extern returns 0 and this
// whole sequence is a safe no-op.
//
// Marker sequence emitted here (asserted by the 2d-4 qemu-llm-smoke gate):
//   ARP: 1  net_connect() resolved 10.0.2.2 -> MAC
//   TCP: 1  the same call completed the TCP handshake
//   SND: 36 net_send() queued the fixed 36-byte request
//   RCV: 36 net_stack_poll() received the response body (<= 256 B)
//
// Fuel discipline: net_connect() and the response poll are bounded by the
// C-side shim (net_rx_wait from 2d-1 + the net_poll_fuel counter) — the poll
// loop uses the glue call in the CONDITION, exactly like the Phase 2b
// `while (fb_loop_frame() < 4)` loop: each iteration re-evaluates
// net_stack_poll() (kernel/net_glue.curlee, gh issue #12), which fails
// closed (returns 2 — not 0) once its C-owned fuel counter is exhausted, so
// the loop provably terminates.
// Phase 2d-3: the pure JSON/tool-call parser bridge (kernel/json.curlee, merged
// in). Reads the received response body byte-by-byte through the 2d-2 glue
// (net_response_len / net_response_byte — genuine Curlee, net_glue.curlee),
// drives the pure state machine (json_step), then:
//   - on parse_error == 0: emits "JSON: 1" and enqueues the tool call
//     (fb_tool_enqueue(2, arg) — kind 2 = "LLM tool call", the 2d-3 contract),
//   - on parse_error != 0: emits "JSON: E<code>" and NEVER enqueues.
//
// This is the only place the externs meet the parser — json.curlee itself is
// extern-free (VM-testable). The full 36-byte LOCKED envelope
// (docs/phase2d-wire.md §3) is asserted by `make json-codegen-run`
// (scripts/run-json-codegen.sh): it codegens json.curlee and drives the
// envelope through the SAME json_step/json_end functions this bridge calls,
// on the host with a real body (no NIC needed). The VM test
// (kernel/json_test.curlee) asserts the phases the VM emitter can run. This
// bridge has no live NIC gate until 2d-4's stub server lands (net_response_len
// is 0 on the current PVH stubs), so the codegen harness is the CI-visible
// full-happy-path proof.
//
// The feed loop is a bounded recursion over an immutable index (no mutable
// counter needed — the established extern-loop pattern, e.g. the `while
// (net_stack_poll() == 0)` poll). json_step ignores bytes once the state
// freezes in the error phase, so the loop provably terminates at len.
fn json_feed(i: Int, rlen: Int, st: Int) -> Int {
  if (i >= rlen) {
    return st;
  } else {
    let c: Int = net_response_byte(i);
    let ns: Int = json_step(c, st);
    return json_feed(i + 1, rlen, ns);
  }
}

// Serial marker "JSON: E<code>" — a single digit 0..9.
fn serial_json_err(pm: cap phys.mem, code: Int) -> Unit {
  putc(pm, 74);   // J
  putc(pm, 83);   // S
  putc(pm, 79);   // O
  putc(pm, 78);   // N
  putc(pm, 58);   // :
  putc(pm, 32);   // space
  putc(pm, 69);   // E
  putc(pm, 48 + code);
  putc(pm, 10);   // newline
  return;
}

// Serial marker "JSON: 1" — parser OK.
fn serial_json_ok(pm: cap phys.mem) -> Unit {
  putc(pm, 74);   // J
  putc(pm, 83);   // S
  putc(pm, 79);   // O
  putc(pm, 78);   // N
  putc(pm, 58);   // :
  putc(pm, 32);   // space
  putc(pm, 49);   // 1
  putc(pm, 10);   // newline
  return;
}

// The 2d-3 bridge: parse the received body and feed the tool-call queue.
// Gated on a response being ready (net_response_len > 0), so the no-NIC /
// no-response baseline emits nothing and existing gates stay green.
fn json_llm_bridge(pm: cap phys.mem) -> Unit {
  let rlen: Int = net_response_len();
  if (rlen > 0) {
    let over: Int = json_check_len(rlen);
    if (over == 1) {
      serial_json_err(pm, 1);         // response > 256 bytes
    } else {
      let st0: Int = json_start();
      let st: Int = json_feed(0, rlen, st0);
      let err: Int = json_end(st);
      if (err == 0) {
        serial_json_ok(pm);
        // Enqueue the parsed tool call (kind 2 = "LLM tool call", arg = the
        // parsed value). The 2d-4 gate asserts "TOOL: 2" (the enqueue
        // SUCCEEDED — proving the bridge reached the 2b tool-call queue),
        // then "LLM: 1" (the ack frame rendered).
        let arg: Int = json_arg_value(st);
        let enq: Int = fb_tool_enqueue(2, arg);
        if (enq == 1) {
          serial_tool_marker(pm, 2);
          // 2d-4 ack: the round-trip is complete — the parsed tool call is in
          // the 2b queue. Emit the "LLM: 1" ack marker (the gate's proof the
          // acknowledgment step ran). The visual "LLM OK" frame on the fb
          // path is a bonus (issue #3's "renders an acknowledgment frame");
          // the serial marker is the deterministic gate.
          serial_llm_marker(pm, 1);
        }
      } else {
        serial_json_err(pm, err);
      }
    }
  }
  return;
}

fn net_llm_roundtrip(pm: cap phys.mem) -> Unit {
  let up: Int = net_link_up();
  if (up == 1) {
    let conn: Int = net_connect(8080);
    if (conn == 1) {
      serial_arp_marker(pm, 1);
      serial_tcp_marker(pm, 1);
      let sent: Int = net_send(36);
      if (sent == 1) {
        serial_snd_marker(pm, 36);
        // Poll until the response body is ready or the stack fails closed.
        // net_stack_poll(): 0 = still reading, 1 = response ready, 2 = fuel
        // exhausted / protocol error, 3 = truncated (Content-Length > 256).
        // Result 3 is also != 0, so the loop terminates for the same reason;
        // net_response_len() reports 0 after truncation, so no marker is
        // emitted for a corrupt body (the 2d-3 parser would see len 0).
        while (net_stack_poll() == 0) {
        }
        let rlen: Int = net_response_len();
        if (rlen > 0) {
          serial_rcv_marker(pm, rlen);
        }
      }
    }
  }
  return;
}

// One frame of the demo scene. Geometry is computed by the verified pure
// helpers (from canvas/glyphs/assets, merged in; provably in-bounds); the C
// blitter executes the pixels.
// The `pm: cap phys.mem` parameter satisfies the verifier's Phys rule and is
// dropped by codegen (C calls curlee_render_frame(void) directly).
//
// Phase 2b: the scene is frame-index-aware so the demo animates — the panel
// rectangle cycles its y position between two rows on alternate frames
// (pure Int math, no mutable state), proving the loop actually re-renders.
//
// Phase 2c (memory & asset management contracts): EVERY primitive is gated by
// the verified pure gate before dispatch — the framebuffer size is read from
// the extern accessors (fb_get_width/fb_get_height) and passed into the pure
// gates (rect_fits_gate / line_fits_gate / char_fits_gate), so a deliberately
// out-of-bounds primitive is SKIPPED (never a partial write). The C blitter
// additionally bounds-checks as defense-in-depth. fb_clear is full-screen, so
// it is always in-bounds by construction (no gate needed).
fn render_frame(pm: cap phys.mem, frame: Int) -> Unit {
  // Bind colors to lets first (the verifier rejects calls as arguments to
  // other calls: "calls are not supported in verification expressions").
  let bg: Int = rgb(8, 8, 12);
  let panel: Int = rgb(220, 80, 40);
  let line: Int = rgb(40, 220, 80);
  let white: Int = rgb(255, 255, 255);
  // Read the runtime framebuffer size from the C accessors (opaque to the
  // verifier — these are extern calls, so the gates below are contract-less
  // and asserted by the VM test; the C blitter double-checks).
  let fbw: Int = fb_get_width();
  let fbh: Int = fb_get_height();
  // Clear to a dark background (full-screen: always in-bounds).
  fb_clear(bg);
  // A panel rectangle. The y position alternates between two rows with the
  // frame index (pure Int math — frame is the loop counter from fb.c, opaque
  // to the verifier, so the arithmetic here is contract-less by design). No
  // modulo (rejected): fold the parity into a subtraction, then scale.
  let panel_parity: Int = frame - (frame / 2) * 2;
  let panel_y: Int = 40 + panel_parity * 60;
  // Gate the fill rect (200x120 at (40, panel_y)): skip if it doesn't fit.
  let panel_fits: Bool = rect_fits_gate(200, 120, 40, panel_y, fbw, fbh);
  if (panel_fits) {
    fb_fill_rect(40, panel_y, 200, 120, panel);
  }
  // Gate the line (1px at y=170 from x=40 to x=240).
  let line_fits: Bool = line_fits_gate(40, 170, 240, 170, fbw, fbh);
  if (line_fits) {
    fb_line(40, 170, 240, 170, line);
  }
  // "JOE" in 4x-scale glyphs at (60, 60) in white — gate each char (5*4 x
  // 7*4 = 20x28 bounding box).
  let j_fits: Bool = char_fits_gate(60, 60, 4, fbw, fbh);
  if (j_fits) {
    draw_glyph(74, 60, 60, 4, white);   // J
  }
  let o_fits: Bool = char_fits_gate(96, 60, 4, fbw, fbh);
  if (o_fits) {
    draw_glyph(79, 96, 60, 4, white);   // O
  }
  let e_fits: Bool = char_fits_gate(132, 60, 4, fbw, fbh);
  if (e_fits) {
    draw_glyph(69, 132, 60, 4, white);  // E
  }
  // Present the frame (Phase 2c: the ring flip).
  fb_present();
  return;
}

// Kernel entry point (codegen exports this as curlee_main).
//
// Renders the Phase 2 demo scene when the linear framebuffer is available,
// else falls back to VGA text + serial (the Phase 1 acceptance path), then
// halts deterministically.
//
// Phase 2b: when the framebuffer is active, `main` drives the deterministic,
// fuel-bounded 60 FPS loop itself — the C driver (fb.c) owns the mutable
// frame counter + tool ring, and Curlee owns the loop policy: render a frame,
// emit FR:<n>, drain the tool queue, advance the counter, stop after
// FB_LOOP_FRAMES frames. The loop is bounded (not `while(true)`) so the
// qemu-fb-smoke / qemu-loop-smoke gates stay deterministic and timeout-safe.
fn main(pm: cap phys.mem) -> Unit {
  // Phase 2d-1: VirtIO-net bring-up first — the NIC sequence (NET: 1..3,
  // RX: <len>) runs before the display branch so the smoke gate can observe
  // it on any boot path. With no virtio-net device, net_probe() finds
  // nothing and the whole sequence is a safe no-op (existing gates stay
  // green — acceptance criterion 6).
  net_bringup(pm);
  // Phase 2d-2: the TCP/IP stack round-trip (ARP -> TCP -> send -> receive).
  // Gated on link-up, so with no NIC (or on the PVH stub path) every extern
  // returns 0 and the whole sequence is a safe no-op — existing gates stay
  // green. The marker sequence (ARP: 1, TCP: 1, SND: 36, RCV: <len>) is
  // asserted by the 2d-4 qemu-llm-smoke gate against a host stub server.
  net_llm_roundtrip(pm);
  // Phase 2d-3: parse the received response (if any) and feed the tool-call
  // queue. Gated on net_response_len > 0, so the no-NIC baseline emits nothing.
  json_llm_bridge(pm);
  // gh issue #15: the multiboot2 info parser is now a genuine Curlee
  // function (kernel/mb2.curlee, ported from kernel/mb2.c). fb_init() is
  // gone — its only logic was "mb2_parse() then fb_wire_draw_target()", and
  // C cannot call up into the codegen (the parse is the static
  // `curlee_mb2_parse` symbol; C boundary policy). So main drives the parse
  // (fills the framebuffer globals via the mb2_state_set shim) then wires
  // the draw target — the multiboot2 tag always wins on the GRUB path.
  let mb2_ok: Int = mb2_parse(pm);
  fb_wire_draw_target();
  // Phase 2f Bochs VBE probe — ported to Curlee in gh issue #11
  // (kernel/vbe.curlee). The C layer cannot call it (codegen emits vbe_probe
  // as a static `curlee_vbe_probe` symbol; C boundary policy), so main
  // drives the probe here. Gated exactly like the former `#ifdef
  // JOE_PVH_BOOT` in the deleted fb.c fb_init: it only runs when the
  // multiboot2 parse found no framebuffer (fb_ready()==0 — the multiboot2
  // tag always wins on the GRUB path) AND this is the PVH build
  // (fb_asset_region_w() reads 0 on PVH builds, 128 on the GRUB build — the
  // same discriminator used below). On success the probe fills the
  // framebuffer globals via the vbe_state_set shim; main then re-wires the
  // draw target (the wiring just after mb2_parse ran while fb_addr was
  // still 0).
  if (fb_ready() == 0) {
    let pvh_build: Int = fb_asset_region_w();
    if (pvh_build == 0) {
      let vbe_ok: Int = vbe_probe(pm);
      if (vbe_ok == 1) {
        fb_wire_draw_target();
      }
    }
  }
  if (fb_ready() == 1) {
    // The linear framebuffer is active. Two sub-paths, distinguished by
    // whether the frame ring/asset region are compiled in:
    //
    // (a) GRUB path (kernel-grub.elf, 32-bit multiboot2 entry): the 32-bit
    //     boot stub (kernel/boot.S, as --32) captured the trusted info
    //     pointer in %ebx and mb2.curlee parsed the framebuffer tag (type 8)
    //     into the blitter globals (gh issue #15); the frame ring is
    //     compiled in and fb_present() performs a REAL back-buffer flip.
    //     Phase 2b: hand off to the deterministic 60 FPS loop (see fb.c
    //     fb_run_loop) — the loop renders N frames, then returns to halt.
    // (b) PVH path (kernel.elf, qemu -kernel): no multiboot2 info; the
    //     framebuffer comes from the Phase 2f Bochs VBE probe
    //     (kernel/vbe.curlee, ported from vbe.c in gh issue #11).
    //     The frame ring/asset region are compiled OUT (JOE_PVH_BOOT — QEMU's
    //     PVH loader rejects a large BSS, see fb.c), so fb_asset_region_w()
    //     reads 0 and fb_present() is a single-buffer no-op. Render ONE frame
    //     directly into the VBE LFB, emit the FB: 1 marker, then halt — the
    //     ring loop stays a GRUB-path feature.
    let region_w: Int = fb_asset_region_w();
    if (region_w == 0) {
      // PVH path: single frame into the VBE-probed LFB (frame 0), then the
      // FB: 1 marker proves fb_ready()==1 and the renderer ran under
      // `qemu -kernel` (make qemu-pvh-fb-smoke greps for it).
      render_frame(pm, 0);
      serial_fb_marker(pm);
    } else {
      // GRUB path: the 60 FPS ring loop.
      fb_loop_init();
      while (fb_loop_frame() < 4) {
        // One tick: render the current frame, emit the loop marker, enqueue
        // a tool intent (exercising the producer API + slot mapping), then
        // let fb_run_loop advance the counter and drain the ring.
        let f: Int = fb_loop_frame();
        render_frame(pm, f);
        serial_frame_marker(pm, f);
        // Producer: enqueue a "frame-tick" intent (kind 1, arg = the frame
        // number). The slot for this frame comes from tool_queue_slot
        // (division-free wrap). kind 1 is the reserved "frame tick" intent
        // kind; future producers (LLM bridge, input) use their own kinds.
        let slot: Int = tool_queue_slot(f);
        let enq: Int = fb_tool_enqueue(1, slot);
        // The ring has 8 slots and we enqueue 1 intent per frame, so enqueue
        // always succeeds here; ignore the return for the smoke path.
        let drained: Int = fb_tool_drained();
        let pending: Int = fb_tool_pending();
        fb_run_loop();
      }
      // After the loop, the frame ring has been exercised (fb_present
      // flipped each frame). Emit the ring-active marker so the smoke gate
      // can prove the Phase 2c flip ran (grep "RING: 1" alongside "FB:").
      let ring_on: Int = fb_ring_active();
      if (ring_on == 1) {
        serial_ring_marker(pm);
      }
      serial_fb_marker(pm);
    }
  } else {
    // No trusted framebuffer (text-mode ISO, no VBE device): VGA text +
    // serial fallback keeps the Phase 1 gates green. vga_text_setup is a
    // genuine Curlee function (kernel/vga_setup.curlee, ported from the
    // deleted kernel/vga_setup.c in issue #10): it programs the VGA CRT
    // controller for text mode 3, then delegates the 0xB8000 buffer clear
    // to the vga_clear_text_buffer raw-memory-move extern.
    vga_text_setup(pm);
  }
  unsafe {
    // Row 0, columns 0..22 (2 bytes per cell, base 0xB8000).
    // "Hello world from JOE" — attribute 0x0F (bright white on black).
    let c0: Phys<U16> = phys<U16>(0xB8000);
    c0.write(vga_cell(72, 15));   // H
    let c1: Phys<U16> = phys<U16>(0xB8002);
    c1.write(vga_cell(101, 15));  // e
    let c2: Phys<U16> = phys<U16>(0xB8004);
    c2.write(vga_cell(108, 15));  // l
    let c3: Phys<U16> = phys<U16>(0xB8006);
    c3.write(vga_cell(108, 15));  // l
    let c4: Phys<U16> = phys<U16>(0xB8008);
    c4.write(vga_cell(111, 15));  // o
    let c5: Phys<U16> = phys<U16>(0xB800A);
    c5.write(vga_cell(32, 15));   // (space)
    let c6: Phys<U16> = phys<U16>(0xB800C);
    c6.write(vga_cell(87, 15));   // W
    let c7: Phys<U16> = phys<U16>(0xB800E);
    c7.write(vga_cell(111, 15));  // o
    let c8: Phys<U16> = phys<U16>(0xB8010);
    c8.write(vga_cell(114, 15));  // r
    let c9: Phys<U16> = phys<U16>(0xB8012);
    c9.write(vga_cell(108, 15));  // l
    let c10: Phys<U16> = phys<U16>(0xB8014);
    c10.write(vga_cell(100, 15)); // d
    let c11: Phys<U16> = phys<U16>(0xB8016);
    c11.write(vga_cell(32, 15));  // (space)
    let c12: Phys<U16> = phys<U16>(0xB8018);
    c12.write(vga_cell(102, 15)); // f
    let c13: Phys<U16> = phys<U16>(0xB801A);
    c13.write(vga_cell(114, 15)); // r
    let c14: Phys<U16> = phys<U16>(0xB801C);
    c14.write(vga_cell(111, 15)); // o
    let c15: Phys<U16> = phys<U16>(0xB801E);
    c15.write(vga_cell(109, 15)); // m
    let c16: Phys<U16> = phys<U16>(0xB8020);
    c16.write(vga_cell(32, 15));  // (space)
    let c17: Phys<U16> = phys<U16>(0xB8022);
    c17.write(vga_cell(74, 15));  // J
    let c18: Phys<U16> = phys<U16>(0xB8024);
    c18.write(vga_cell(79, 15));  // O
    let c19: Phys<U16> = phys<U16>(0xB8026);
    c19.write(vga_cell(69, 15));  // E
    let c20: Phys<U16> = phys<U16>(0xB8028);
    c20.write(vga_cell(33, 15));  // !
    let c21: Phys<U16> = phys<U16>(0xB802A);
    c21.write(vga_cell(32, 15));  // (space)
    let c22: Phys<U16> = phys<U16>(0xB802C);
    c22.write(vga_cell(32, 15));  // (space)
  }
  serial_hello(pm);
  curlee_halt();
  return;
}

// Pack (char, color attribute) into the 2-byte VGA cell value:
//   low byte  = ASCII character
//   high byte = attribute (foreground | background << 4)
// Pure and total: any Int in, a cell value out.
fn vga_cell(ch: Int, attr: Int) -> Int
  [ requires ch >= 0 && ch < 256; ensures true; ] {
  return ch + attr * 256;
}
