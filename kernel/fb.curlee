// SPDX-License-Identifier: GPL-3.0
//
// fb.curlee — linear framebuffer software blitter + 60 FPS event loop,
// ported from kernel/fb.c (gh issue #13).
//
// This is the IMPERATIVE layer of the renderer: it executes the pixel
// loops. canvas.curlee / glyphs.curlee / assets.curlee compute the geometry
// and intent (pure, verified); this module executes the pixels through the
// runtime-address physical-memory externs (phys_write_u32, fb_mem_read_u32).
//
// What moved to Curlee (the ~150 lines of blitter-loop + event-loop logic
// from fb.c): the pixel primitives (fb_clear, fb_pixel, fb_fill_rect,
// fb_line, fb_blit_asset), the Phase 2c ring flip (fb_present), the Phase 2b
// tool-call queue (fb_tool_enqueue / fb_tool_drained / fb_tool_pending /
// fb_run_loop / fb_loop_init / fb_loop_frame), and the accessor/geometry
// layer (fb_ready / fb_wire_draw_target / fb_get_width / fb_get_height /
// fb_ring_active / fb_ring_slot). The extern surface these functions replace
// is consumed by kernel.curlee's render_frame/main loop and the canvas
// verifier fragment (canvas_test.curlee §12 asserts the tool-queue geometry
// tool_queue_slots()==8 / tool_slot_bytes()==16 stays in sync).
//
// What stays in C (kernel/fb.c, the vbe_state.c / net_stack.c precedent):
//   - ALL mutable state — the framebuffer globals (fb_addr/pitch/width/
//     height, filled by mb2_state.c / vbe_state.c), the static asset region
//     + frame ring arrays, the ring bookkeeping (ring_active / ring_slot),
//     the draw-target indirection (fb_draw_target / fb_target_stride), and
//     the tool-call ring (tool_queue + head/count + loop counters). Curlee
//     has no module-level globals and no arrays (verified language gaps,
//     documented in net_stack.c's header) — the state lives in C and is
//     exposed through the thin extern window declared below.
//   - The raw runtime-address memory moves: phys_write_u32 (the write
//     counterpart of mb2_state.c's phys_read_u8/u32 — curlee #279's family,
//     now extended with writes) and fb_mem_read_u32 (a bit-preserving
//     read; the draw target / asset source are runtime addresses, which a
//     compile-time-literal Phys<T> cannot address).
//   - The compile-time build discrimination: fb_pvh_build() (1 on the PVH
//     build where the ring/region compile to 1-byte stubs, 0 on the GRUB
//     build). The Curlee fb_asset_region_w/h below combine it with the pure
//     region geometry (asset_region_w/h()==128, VM-asserted in
//     canvas_test.curlee §14) so the accessors return 0 vs. 128 per build —
//     the JOE_PVH_BOOT discrimination kernel.curlee's main gates the ring
//     loop on — and fb_asset_region_base wraps the region address getter.
//
// Why the extern boundary is trusted (no cap phys.mem threading): the
// phys_read_u*/port-I/O externs in mb2.curlee/serial.curlee/vbe.curlee take
// `cap phys.mem` + unsafe as belt-and-suspenders, but the capability rule is
// a Phys<T> language feature, not an extern rule (verified empirically with
// `curlee check`: a plain function calling phys_write_u32 type-checks and
// codegens without the cap). Keeping the blitter signatures identical to the
// externs they replace preserves kernel.curlee's call sites byte-for-byte.
//
// Geometry constants are INLINED (8 tool slots, 640x480 ring slots, ...)
// rather than calling assets.curlee's pure helpers: this module is merged
// into the kernel TU by concatenation (scripts/build-kernel.sh) and is
// `curlee check`ed STANDALONE (the net_glue.curlee exception — it cannot
// call another module), exactly like the C #defines they replace. The
// constants mirror the VM-asserted pure values (canvas_test.curlee §12/§15
// cross-checks both sides, so a drift fails `make canvas-run` before boot).
//
// Design laws honored:
//   - Single address space, Ring 0: pixel writes are direct volatile stores
//     at runtime addresses (phys_write_u32 / fb_mem_read_u32).
//   - Deterministic verification: `curlee check fb.curlee` runs standalone
//     and the merged kernel re-verifies it (`make check`); the blitter is
//     contract-less (every value it consumes is opaque extern state), with
//     all non-linear address math hidden in contract-less helpers (the
//     established canvas/net_glue pattern — variable*variable mult is
//     rejected by the verifier).
//   - Minimal footprint: no libc, no malloc, no String/Vec; static arrays
//     owned by the C shim.

// ---------------------------------------------------------------------------
// Extern window into the C state shim (kernel/fb.c). Every symbol is defined
// 1:1 in C; the codegen emits direct calls. Declared HERE, once — the merged
// TU forbids duplicate externs (net_glue.curlee's note).
// ---------------------------------------------------------------------------

// Framebuffer globals (filled by mb2_state.c / vbe_state.c).
extern fn fb_addr_get() -> Int;
extern fn fb_pitch_get() -> Int;
extern fn fb_width_get() -> Int;
extern fn fb_height_get() -> Int;

// Draw-target indirection: the blitter writes to fb_draw_target (an abstract
// 32bpp surface with its own stride) instead of the visible framebuffer when
// the ring is active. Before the first present the target IS the visible
// framebuffer (fb_addr), preserving 2a/2e single-buffer behavior exactly.
extern fn fb_draw_target_addr() -> Int;
extern fn fb_target_stride_get() -> Int;
extern fn fb_target_set(addr: Int, stride: Int) -> Unit;

// Frame-ring bookkeeping (ring_active / ring_slot live in C).
extern fn fb_ring_active_get() -> Int;
extern fn fb_ring_slot_get() -> Int;
// Activate the ring on the first fb_present(): ring_active=1, slot=0, and
// the draw target re-points at frame_ring[0] with stride 640*4. Returns 1 on
// a real activation, 0 on the PVH build (ring compiled out — no-op).
extern fn fb_ring_activate() -> Int;
// Advance the ring after a flip: slot = (slot+1) % 2 (division-free in C),
// draw target re-points at the new back buffer. No-op on the PVH build.
extern fn fb_ring_advance() -> Unit;

// Tool-call ring (8 fixed slots of two Ints each; the struct layout lives in
// C, the LOGIC is here). A slot is "empty" when its kind is 0 (kind 0 is
// reserved as the null intent).
extern fn fb_tool_slot_set(slot: Int, kind: Int, arg: Int) -> Unit;
extern fn fb_tool_head() -> Int;
extern fn fb_tool_head_set(h: Int) -> Unit;
extern fn fb_tool_count() -> Int;
extern fn fb_tool_count_set(c: Int) -> Unit;
extern fn fb_tool_drained_get() -> Int;
extern fn fb_tool_drained_set(d: Int) -> Unit;

// Loop fuel + the full loop-init reset (frame counter + tool ring + frame
// ring back to single-buffer mode).
extern fn fb_loop_frame_get() -> Int;
extern fn fb_loop_frame_set(f: Int) -> Unit;
extern fn fb_loop_state_reset() -> Unit;

// Raw runtime-address memory moves (defined in kernel/fb.c):
//   - phys_write_u32: volatile 32-bit store at a runtime address — the write
//     counterpart of mb2_state.c's phys_read_u32 (curlee #279's family,
//     extended with writes). This is the ONLY way to touch the hardware
//     framebuffer, whose address is discovered at boot (mb2_parse /
//     vbe_probe) and is therefore never a compile-time literal.
//   - fb_mem_read_u32: bit-preserving volatile 32-bit load cast to Int. The
//     read side of the same boundary; named distinctly because mb2.curlee
//     already declares phys_read_u32 (which returns U32 — the merged TU
//     forbids duplicate externs, and a U32->Int conversion at every pixel
//     would be noise). Pixel data is round-tripped, so the sign of the Int
//     view is irrelevant (phys_write_u32 casts back to uint32_t).
//   - fb_pvh_build / fb_asset_region_base_get: the compile-time build
//     discrimination (1 vs 0) and the asset-region address (0 on the PVH
//     1-byte stub).
extern fn phys_write_u32(addr: Int, value: Int) -> Unit;
extern fn fb_mem_read_u32(addr: Int) -> Int;
extern fn fb_pvh_build() -> Int;
extern fn fb_asset_region_base_get() -> Int;

// ---------------------------------------------------------------------------
// Contract-less address/math helpers (non-linear arithmetic is rejected by
// the verifier in checked positions — the established canvas/net_glue
// pattern: hide variable*variable multiplication in opaque helpers).
// ---------------------------------------------------------------------------

// Pixel address of (x, y) on a 32bpp surface: base + y*stride_px + x, where
// stride is the BYTE stride (divide by 4 to get pixels per row).
fn fb_xy_addr(base: Int, stride: Int, x: Int, y: Int) -> Int {
  return base + y * (stride / 4) + x;
}

// Pixel address `(py * src_w + px) * 4` bytes past the 32bpp source buffer.
fn fb_blit_src_addr(src: Int, src_w: Int, x: Int, y: Int) -> Int {
  return src + (y * src_w + x) * 4;
}

// Total pixels of a w x h surface (the fb_clear loop bound).
fn fb_clear_total(w: Int, h: Int) -> Int {
  return w * h;
}

// Absolute value (Bresenham). Contract-less; the C original used a ternary.
fn fb_iabs(a: Int) -> Int {
  if (a >= 0) {
    return a;
  } else {
    return -a;
  }
}

// Sign of a step direction (Bresenham): 1 for a positive/zero diff, -1 for a
// negative diff. The C original's `(a < b) ? 1 : -1`; the zero case's sign
// is never used (the loop breaks before a zero-length axis steps).
fn fb_isign(a: Int) -> Int {
  if (a >= 0) {
    return 1;
  } else {
    return -1;
  }
}

// Next tool-ring write index after `cur` (division-free wrap — no `%`
// operator): the mirror of assets.curlee's tool_ring_next for the 8-slot
// ring (tool_queue_slots()==8, VM-asserted in canvas_test.curlee §12).
fn fb_tool_ring_next(cur: Int) -> Int {
  if (cur + 1 == 8) {
    return 0;
  } else {
    return cur + 1;
  }
}

// Index of the OLDEST live tool intent: the producer cursor is `head` (the
// next write position) and `count` intents are live, so the oldest is at
// (head - count) mod 8. Division-free wrap: head + 8 - count lands in
// [0, 16), so one conditional subtract wraps it. Mirror of assets.curlee's
// tool_ring_oldest (added for this port, VM-asserted in canvas_test.curlee
// §12) — the C shim no longer computes this (the drain moved here).
fn fb_tool_ring_oldest(head: Int, count: Int) -> Int {
  let t: Int = head + 8 - count;
  if (t >= 8) {
    return t - 8;
  } else {
    return t;
  }
}

// ---------------------------------------------------------------------------
// Accessors / geometry (the Phase 2c externs render_frame's gates read)
// ---------------------------------------------------------------------------

fn fb_ready() -> Int {
  let a: Int = fb_addr_get();
  if (a != 0) {
    return 1;
  } else {
    return 0;
  }
}

fn fb_get_width() -> Int {
  return fb_width_get();
}

fn fb_get_height() -> Int {
  return fb_height_get();
}

fn fb_ring_active() -> Int {
  return fb_ring_active_get();
}

fn fb_ring_slot() -> Int {
  return fb_ring_slot_get();
}

// Static asset-region geometry: the PVH build compiles the region to a
// 1-byte stub (fb_pvh_build()==1) and these return 0 — the discriminator
// kernel.curlee's main gates the ring loop on; the GRUB build returns the
// pure region geometry (asset_region_w/h()==128, VM-asserted in
// canvas_test.curlee §14; the C ASSET_REGION_W/H #defines mirror it).
fn fb_asset_region_w() -> Int {
  let pvh: Int = fb_pvh_build();
  if (pvh == 1) {
    return 0;
  } else {
    return 128;   // asset_region_w() (canvas_test §14)
  }
}

fn fb_asset_region_h() -> Int {
  let pvh: Int = fb_pvh_build();
  if (pvh == 1) {
    return 0;
  } else {
    return 128;   // asset_region_h() (canvas_test §14)
  }
}

fn fb_asset_region_base() -> Int {
  return fb_asset_region_base_get();
}

// Phase 2e-2/2f: wire the draw target to the visible framebuffer. Before the
// frame ring activates, the draw target IS the visible framebuffer
// (single-buffer 2a/2e behavior exactly); fb_present() re-points it at the
// ring back buffers on the GRUB path. Gated on fb_addr != 0 (not the build
// macro) so it covers both paths: GRUB (multiboot2 tag) and PVH (VBE probe).
fn fb_wire_draw_target() -> Unit {
  let a: Int = fb_addr_get();
  if (a != 0) {
    let p: Int = fb_pitch_get();
    fb_target_set(a, p);
  }
  return;
}

// ---------------------------------------------------------------------------
// Pixel primitives (all bounds-checked, all writing through the draw target
// — defense-in-depth over the Curlee geometry layer, which is provably
// in-bounds; out-of-bounds writes are impossible by construction)
// ---------------------------------------------------------------------------

fn fb_clear(color: Int) -> Unit {
  let base: Int = fb_draw_target_addr();
  if (base == 0) {
    return;
  }
  let w: Int = fb_width_get();
  let h: Int = fb_height_get();
  let total: Int = fb_clear_total(w, h);
  let i: Int = 0;
  while (i < total) {
    phys_write_u32(base + i * 4, color);
    i = i + 1;
  }
  return;
}

fn fb_pixel(x: Int, y: Int, color: Int) -> Unit {
  let base: Int = fb_draw_target_addr();
  if (base == 0) {
    return;
  }
  let w: Int = fb_width_get();
  let h: Int = fb_height_get();
  if (x < 0 || y < 0 || x >= w || y >= h) {
    return;
  }
  let stride: Int = fb_target_stride_get();
  let a: Int = fb_xy_addr(base, stride, x, y);
  phys_write_u32(a, color);
  return;
}

fn fb_fill_rect(x: Int, y: Int, w: Int, h: Int, color: Int) -> Unit {
  let base: Int = fb_draw_target_addr();
  if (base == 0) {
    return;
  }
  if (w <= 0 || h <= 0) {
    return;
  }
  // Clip to the framebuffer (defense-in-depth; Curlee geometry is already
  // in-bounds via clip_rect/rect_fits_gate). imin/imax are assets.curlee's
  // helpers — NOT available here (standalone-checkable module), so the
  // clamping is inlined as fb_imin / fb_max0.
  let fbw: Int = fb_width_get();
  let fbh: Int = fb_height_get();
  let x0: Int = fb_max0(x);   // x < 0 ? 0 : x
  let y0: Int = fb_max0(y);   // y < 0 ? 0 : y
  let xe: Int = x + w;
  let ye: Int = y + h;
  let x1: Int = fb_imin(xe, fbw);
  let y1: Int = fb_imin(ye, fbh);
  let stride: Int = fb_target_stride_get();
  let py: Int = y0;
  while (py < y1) {
    let px: Int = x0;
    while (px < x1) {
      let a: Int = fb_xy_addr(base, stride, px, py);
      phys_write_u32(a, color);
      px = px + 1;
    }
    py = py + 1;
  }
  return;
}

// Bresenham line. Bounds-checked per pixel (clipped at the edges — fb_pixel
// no-ops out of bounds). Direct algorithmic port of the C original; the
// `while (1) { ... break; }` shape becomes a `done` flag (no break in
// Curlee) and the mutable cursor (x0, y0, err) becomes assignments.
fn fb_line(x0: Int, y0: Int, x1: Int, y1: Int, color: Int) -> Unit {
  let addr: Int = fb_addr_get();
  if (addr == 0) {
    return;
  }
  let dx: Int = fb_iabs(x1 - x0);
  let dy: Int = fb_iabs(y1 - y0);
  let sx: Int = fb_isign(x1 - x0);
  let sy: Int = fb_isign(y1 - y0);
  let err: Int = dx - dy;
  let cx: Int = x0;
  let cy: Int = y0;
  let done: Bool = false;
  while (!done) {
    fb_pixel(cx, cy, color);
    if (cx == x1 && cy == y1) {
      done = true;
    } else {
      let e2: Int = 2 * err;
      if (e2 > -dy) {
        err = err - dy;
        cx = cx + sx;
      }
      if (e2 < dx) {
        err = err + dx;
        cy = cy + sy;
      }
    }
  }
  return;
}

// Asset blitting (32bpp RAW pixel buffer): copy src_w x src_h pixels from
// the runtime address `src` to (dst_x, dst_y) on the draw target. Full OOB
// gate: the whole asset must fit (Curlee's blit_fits already guarantees
// this; double-check as defense-in-depth).
fn fb_blit_asset(src: Int, src_w: Int, src_h: Int, dst_x: Int, dst_y: Int) -> Unit {
  let base: Int = fb_draw_target_addr();
  if (base == 0 || src == 0) {
    return;
  }
  if (src_w <= 0 || src_h <= 0) {
    return;
  }
  let fbw: Int = fb_width_get();
  let fbh: Int = fb_height_get();
  if (dst_x < 0 || dst_y < 0 || dst_x + src_w > fbw || dst_y + src_h > fbh) {
    return;
  }
  let stride: Int = fb_target_stride_get();
  let py: Int = 0;
  while (py < src_h) {
    let px: Int = 0;
    while (px < src_w) {
      let sa: Int = fb_blit_src_addr(src, src_w, px, py);
      let v: Int = fb_mem_read_u32(sa);
      let da: Int = fb_xy_addr(base, stride, dst_x + px, dst_y + py);
      phys_write_u32(da, v);
      px = px + 1;
    }
    py = py + 1;
  }
  return;
}

// ---------------------------------------------------------------------------
// Present + ring flip (Phase 2c)
// ---------------------------------------------------------------------------
//
// Lifecycle (identical to the C original):
//   1. Before the first present, ring_active == 0 and the draw target IS the
//      visible framebuffer (single-buffer 2a/2e behavior exactly — writes
//      are immediately visible, fb_present is a no-op).
//   2. On the first present, if the framebuffer fits a ring slot
//      (frame_ring_fits — 640x480 max, the GRUB request tag's size; the pure
//      constants frame_ring_max_w/h are VM-asserted in canvas_test §15), the
//      ring activates: the C shim sets ring_active=1 and re-points the draw
//      target at frame_ring[0].
//   3. Every subsequent present copies the CURRENT back buffer onto the
//      visible framebuffer (a full-frame 32bpp copy bounded by
//      fb_width * fb_height * 4), then advances ring_slot (0->1->0, matching
//      assets.curlee's frame_ring_next) and re-points the target at the new
//      back buffer.
//
// The flip is a copy (not a page flip) because the multiboot2 framebuffer is
// a single linear surface — there is no hardware scanline base to swap. The
// PVH path: the ring is compiled out, fb_ring_activate() is a 1-byte stub
// returning 0, and this function is a no-op — single-buffer 2a/2e behavior
// exactly (the VBE-probed LFB is the draw target and writes go straight to
// it, matching the C #ifdef JOE_PVH_BOOT present).
fn fb_present() -> Unit {
  let addr: Int = fb_addr_get();
  if (addr == 0) {
    return;
  }
  let active: Int = fb_ring_active_get();
  if (active == 0) {
    // First present: check the framebuffer fits a ring slot (same gate as
    // frame_ring_fits). If not, stay single-buffered forever (no-op present
    // — preserves 2a/2e behavior on oversized modes).
    let w: Int = fb_width_get();
    let h: Int = fb_height_get();
    if (w <= 640 && h <= 480) {   // frame_ring_max_w/h() (canvas_test §15)
      fb_ring_activate();
    }
    return;
  }
  // Ring active: copy the back buffer we just rendered onto the visible
  // framebuffer, then advance the slot (verified ring arithmetic).
  let base: Int = fb_draw_target_addr();
  let stride: Int = fb_target_stride_get();
  let pitch: Int = fb_pitch_get();
  let w: Int = fb_width_get();
  let h: Int = fb_height_get();
  let row: Int = 0;
  while (row < h) {
    let col: Int = 0;
    while (col < w) {
      let sa: Int = fb_xy_addr(base, stride, col, row);
      let v: Int = fb_mem_read_u32(sa);
      let da: Int = fb_xy_addr(addr, pitch, col, row);
      phys_write_u32(da, v);
      col = col + 1;
    }
    row = row + 1;
  }
  fb_ring_advance();
  return;
}

// ---------------------------------------------------------------------------
// Phase 2b: 60 FPS event loop + kernel tool-call queue
// ---------------------------------------------------------------------------
//
// Curlee's `main` drives the deterministic while-loop; per frame it calls:
//
//   frame = fb_loop_frame();   // current counter
//   render_frame(pm, frame);   // Curlee scene (frame-aware)
//   serial marker;             // FR:<n> (qemu-loop-smoke gate)
//   fb_run_loop();             // ONE tick: drain the tool ring + advance
//
// The loop is fuel-bounded in Curlee (while fb_loop_frame() < N), so the
// smoke gates stay deterministic and timeout-safe: the kernel renders N
// frames, emits FB: 1, then falls through to the Phase 1 VGA + serial +
// halt path. No malloc, no libc — static arrays in the C shim only.

// Tool-queue ring geometry (8 slots x 16 bytes). MUST stay in sync with
// assets.curlee: tool_queue_slots()==8, tool_slot_bytes()==16 —
// canvas_test.curlee §12 asserts the exact values; a drift fails `make
// canvas-run` before any boot.

// Enqueue a (kind, arg) tool intent into the fixed ring.
// Returns 1 on success, 0 when the ring is full (producers must back off).
// Kind 0 is reserved (null intent) — never enqueue kind 0.
fn fb_tool_enqueue(kind: Int, arg: Int) -> Int {
  if (kind == 0) {
    return 0;
  }
  let c: Int = fb_tool_count();
  if (c >= 8) {   // tool_queue_slots() == 8 (canvas_test §12)
    return 0;     // ring full
  }
  let h: Int = fb_tool_head();
  fb_tool_slot_set(h, kind, arg);
  let nh: Int = fb_tool_ring_next(h);
  fb_tool_head_set(nh);
  fb_tool_count_set(c + 1);
  return 1;
}

// Number of tool intents currently queued (0..8).
fn fb_tool_pending() -> Int {
  return fb_tool_count();
}

// Number of tool intents drained by the last fb_run_loop() tick.
fn fb_tool_drained() -> Int {
  return fb_tool_drained_get();
}

// Reset the frame counter + tool ring (+ the frame ring back to single-buffer
// mode on the GRUB path) — called once by Curlee main before entering the
// loop. The C shim owns the assignments.
fn fb_loop_init() -> Unit {
  fb_loop_state_reset();
  return;
}

// Current frame counter (the loop's fuel in Curlee main).
fn fb_loop_frame() -> Int {
  return fb_loop_frame_get();
}

// One loop tick: consume (drain) any queued tool intents, then advance the
// frame counter. The actual render + present happen in Curlee's render_frame
// (called by main before fb_run_loop; render_frame calls fb_present() last,
// which performs the Phase 2c back-buffer flip).
//
// Deterministic + fuel-bounded by design: it never spins; it advances the
// counter exactly once per call, so the Curlee while-loop is the fuel gate.
// The drain reads the OLDEST live slot ((head - count) mod 8 — the
// division-free fb_tool_ring_oldest) and clears it (kind 0 = null intent),
// proving the ring advances and keeping the queue bounded (producers can
// never outrun the consumer beyond the fixed capacity).
fn fb_run_loop() -> Unit {
  let drained: Int = 0;
  let c: Int = fb_tool_count();
  while (c > 0) {
    let h: Int = fb_tool_head();
    let idx: Int = fb_tool_ring_oldest(h, c);
    fb_tool_slot_set(idx, 0, 0);   // consume: clear the reserved kind 0
    fb_tool_count_set(c - 1);
    drained = drained + 1;
    c = c - 1;
  }
  fb_tool_drained_set(drained);
  let f: Int = fb_loop_frame_get();
  fb_loop_frame_set(f + 1);
  return;
}

// ---------------------------------------------------------------------------
// Clamping helpers (fb_fill_rect's clip; standalone twins of assets.curlee's
// imin/imax — that module is not importable from this one)
// ---------------------------------------------------------------------------

fn fb_imin(a: Int, b: Int) -> Int {
  if (a <= b) {
    return a;
  } else {
    return b;
  }
}

fn fb_max0(a: Int) -> Int {
  if (a >= 0) {
    return a;
  } else {
    return 0;
  }
}
