import irq_snn_guard as guard;

fn main() -> Int {
  let quiet: Int = guard.irq_snn_step(0, 10, 0, 5, 0);
  if (quiet != 0) { return 1; }

  let hot: Int = guard.irq_snn_step(1800, 255, 8, 255, 8);
  if (hot != 2882) { return 2; }
  let storm: Int = guard.irq_snn_event(hot);
  if (storm != 2) { return 3; }

  let suspect: Int = guard.irq_guard_next(0, 1);
  if (suspect != 1) { return 4; }
  let first_action: Int = guard.irq_guard_action(0, 1);
  if (first_action != 1) { return 5; }

  let confirmed: Int = guard.irq_guard_next(suspect, storm);
  if (confirmed != 2) { return 6; }
  let reset_action: Int = guard.irq_guard_action(suspect, storm);
  if (reset_action != 2) { return 7; }

  let cooldown: Int = guard.irq_guard_next(confirmed, storm);
  if (cooldown != 3) { return 8; }
  let observe: Int = guard.irq_guard_next(cooldown, 0);
  if (observe != 0) { return 9; }

  // Unknown events never authorize an action.
  let unknown_action: Int = guard.irq_guard_action(1, 3);
  if (unknown_action != 0) { return 10; }
  let unknown_state: Int = guard.irq_guard_next(1, 3);
  if (unknown_state != 0) { return 11; }

  // Exhaust the complete 2-bit logic-unit transition table (32 retained
  // membrane states * 4^4 input combinations). The aggregate constants are
  // an inexpensive truth-table fingerprint shared with nir-c-runtime.
  let score_sum: Int = 0;
  let spike_count: Int = 0;
  let membrane: Int = 0;
  while (membrane < 32) {
    let irq: Int = 0;
    while (irq < 4) {
      let timeout: Int = 0;
      while (timeout < 4) {
        let pressure: Int = 0;
        while (pressure < 4) {
          let errors: Int = 0;
          while (errors < 4) {
            let score: Int = guard.irq_snn_logic_step(
              membrane, irq, timeout, pressure, errors
            );
            score_sum = score_sum + score;
            let spike: Bool = guard.irq_snn_logic_spike(score);
            if (spike) { spike_count = spike_count + 1; }
            errors = errors + 1;
          }
          pressure = pressure + 1;
        }
        timeout = timeout + 1;
      }
      irq = irq + 1;
    }
    membrane = membrane + 1;
  }
  if (score_sum != 211482) { return 12; }
  if (spike_count != 7248) { return 13; }
  return 0;
}
