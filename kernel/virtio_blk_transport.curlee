// SPDX-License-Identifier: GPL-3.0
// Legacy PCI transport and one VirtIO block request queue.

static vblk_io_base: Int = 0;
static vblk_found: Int = 0;
static vblk_ready: Int = 0;
static vblk_capacity: Int = 0;
static vblk_ring_base: Int = 0;
static vblk_error: Int = 0;
static vblk_queue_size: Int = 0;

fn vblk_pci_read(
  pm: cap phys.mem,
  bus: Int,
  dev: Int,
  func: Int,
  off: Int
) -> Int {
  unsafe {
    let addr: Int = 2147483648 | (bus << 16) | (dev << 11) |
      (func << 8) | (off & 252);
    port_outl(3320, addr);
    let value: U32 = port_inl(3324);
    return value + 0;
  }
}

fn vblk_match_function(pm: cap phys.mem, dev: Int, func: Int) -> Int {
  let id: Int = vblk_pci_read(pm, 0, dev, func, 0);
  if ((id & 65535) != 6900) { return 0; }
  let device: Int = (id >> 16) & 65535;
  if (device != 4097 && device != 4162) { return 0; }
  let bar: Int = vblk_pci_read(pm, 0, dev, func, 16);
  if ((bar & 1) == 0) { return 0; }
  vblk_io_base = bar & 65532;
  if (vblk_io_base == 0) { return 0; }
  return 1;
}

fn blk_probe(pm: cap phys.mem) -> Int {
  if (vblk_found == 1) { return 1; }
  let dev: Int = 0;
  while (dev < 32) {
    let func: Int = 0;
    while (func < 8) {
      if (vblk_match_function(pm, dev, func) == 1) {
        vblk_found = 1;
        return 1;
      }
      func = func + 1;
    }
    dev = dev + 1;
  }
  return 0;
}

fn vblk_zero_queue(pm: cap phys.mem, base: Int) -> Unit {
  let i: Int = 0;
  unsafe {
    while (i < 8192) {
      phys_write_u32(base + i * 4, 0);
      i = i + 1;
    }
  }
  return;
}

fn vblk_setup_queue(pm: cap phys.mem) -> Int {
  let raw: Int = vblk_qmem_base(pm);
  if (raw == 0) {
    vblk_error = 4;
    return 0;
  }
  unsafe {
    port_outw(vblk_io_base + 14, 0);
    let num: U16 = port_inw(vblk_io_base + 12);
    let n: Int = num + 0;
    vblk_queue_size = n;
    if (n < 3) {
      vblk_error = 5;
      return 0;
    }
    if (n > 1024) {
      vblk_error = 6;
      return 0;
    }
  }
  let base: Int = (raw + 4095) & ~4095;
  vblk_zero_queue(pm, base);
  unsafe { port_outl(vblk_io_base + 8, base >> 12); }
  vblk_ring_base = base;
  return 1;
}

fn vblk_read_capacity(pm: cap phys.mem) -> Int {
  unsafe {
    let low: U32 = port_inl(vblk_io_base + 20);
    let high: U32 = port_inl(vblk_io_base + 24);
    return (low + 0) + (high + 0) * 4294967296;
  }
}

fn blk_init(pm: cap phys.mem) -> Int {
  if (vblk_ready == 1) { return 1; }
  if (vblk_is_stub()) { return 0; }
  if (blk_probe(pm) != 1) { return 0; }
  unsafe {
    port_outb(vblk_io_base + 18, 0);
    port_outl(vblk_io_base + 4, 0);
    port_outb(vblk_io_base + 18, 3);
  }
  if (vblk_setup_queue(pm) != 1) { return 0; }
  unsafe { port_outb(vblk_io_base + 18, 7); }
  vblk_capacity = vblk_read_capacity(pm);
  vblk_ready = 1;
  return 1;
}

fn blk_error_code() -> Int {
  return vblk_error;
}

fn blk_queue_size() -> Int {
  return vblk_queue_size;
}

fn blk_capacity_sectors() -> Int {
  return vblk_capacity;
}

fn vblk_notify(pm: cap phys.mem) -> Unit {
  unsafe { port_outw(vblk_io_base + 16, 0); }
  return;
}

fn vblk_yield(pm: cap phys.mem) -> Unit {
  unsafe { let isr: U8 = port_inb(vblk_io_base + 19); }
  return;
}
