// SPDX-License-Identifier: GPL-3.0
//
// virtio_net.curlee — Phase 2d-1 VirtIO-net driver (RX/TX ring, init,
// link-up), ported from the former kernel/virtio_net.c (798 lines, gh
// issue #14).
//
// Boot path & transport (LOCKED in issue #5 / plans/phase2d-1-virtio-net.md):
//   Legacy virtio 0.9.5 over the PCI I/O BAR. The smoke path boots QEMU with
//   `-device virtio-net-pci,disable-modern=on,netdev=n0`, which makes the
//   device present the legacy ID 0x1000 and the legacy-only register layout
//   (QueuePFN / legacy status / device config at BAR0+0x14). No capability
//   walk, no MSI-X, no modern registers. The driver NEVER offers
//   VIRTIO_F_VERSION_1 (bit 32) — impossible anyway, the legacy guest-features
//   register is 32 bits wide — which is what keeps the device in legacy mode.
//
// Smoke frame source (LOCKED in issue #5, adapted for QEMU 10): the plan's
// slirp auto-ARP-answer (guest ARPs gateway 10.0.2.2 -> slirp replies) does
// not fire on QEMU 10.0.11 user-net in practice (verified empirically). The
// deterministic replacement keeps the same guest-ARP mechanism but uses a
// second QEMU instance connected via a socket netdev: the sender's broadcast
// ARP request is delivered by the socket backend to the receiver's NIC, which
// reports RX: <len>. No host-side injection, no live network. See the
// qemu-net-smoke Makefile target.
//
// Ring layout (matches Linux vring_init + QEMU legacy exactly):
//   queue base (4096-aligned) -> PFN register = phys >> 12
//     page 0: vring_desc[256]   (16 B each)
//     page 1: vring_avail       (flags + idx + ring[256])
//     page 2: vring_used        (flags + idx + ring[256] of {id,len})
//   There is no GuestPageSize register in the shipped legacy layout: Linux
//   (virtio_pci_legacy.c, VIRTIO_PCI_QUEUE_ADDR_SHIFT 12) and QEMU both fix
//   the PFN unit at 4096 bytes. The issue's mention is a draft-era register.
//
// PVH sizing mode (LOCKED option 2 default, option 1 fallback):
//   GRUB build (no JOE_PVH_BOOT) — OPTION 2 ACTIVE: full rings (2 RX x 2048 B
//   + 2 TX x 2048 B, ring depth 256). The NIC runs on the GRUB/ISO path, which
//   is where qemu-net-smoke boots.
//   PVH build (JOE_PVH_BOOT) — OPTION 1 ACTIVE: the ring/buffer memory is
//   stubbed to 1 element (Curlee statics sized by --define, gh issue #296),
//   every base getter returns 0, and net_probe() is a safe no-op. Trigger:
//   the documented Phase 2f measurement (docs/phase2f-report.md §4) that
//   QEMU's `-kernel` PVH machine (xenpvh) exposes NO legacy PCI config space
//   — every 0xCF8/0xCFC read returns 0 regardless of machine type or device
//   — so the NIC is unreachable there, and stubbing keeps the image inside
//   the PVH LOAD budget. The getter surface is identical on both paths.
//
// PORT NOTE — per-build-target static array sizing (gh issue #296): the
//   5-page ring memory and the 2048-byte RX/TX data buffers are Curlee
//   statics whose sizes are constant expressions over build-time constants
//   injected with `curlee build --define NAME=VALUE`. The SAME merged source
//   is built twice: the PVH build (JOE_PVH_BOOT=1) sizes the qmem to 1 page
//   and the data buffers to 1 element, so the image stays inside QEMU's PVH
//   LOAD budget (docs/phase2c-report.md §4.3); the GRUB build (full defines)
//   gets the option-2 rings where the NIC runs. This replaces the former
//   kernel/virtio_net.c `#ifndef JOE_PVH_BOOT` shim (DELETED), and the base
//   addresses flow in through Curlee `addr_of` reads (issue #286) instead of
//   C getter externs — the "address-of a Curlee-owned buffer" gap the port
//   originally dodged is now closed. The descriptor addr field (u64) is
//   built with the Int -> U64 widening for values < 2^32 (curlee #277) or
//   written low-32-only when the pages were pre-zeroed (the high dword is 0
//   for every buffer below 4 GiB).
//
// PORT NOTE — memory barriers (the 2d-1 review flag): the C original's
//   net_mem_barrier (a compiler barrier, __asm__ volatile("" ::: "memory"))
//   is REDUNDANT in the codegen: every ring access is a phys_write_u*/u64
//   or phys_read_u* builtin, which codegen as *(volatile uintN_t*)(addr)
//   loads/stores — GCC never reorders volatile accesses relative to each
//   other, so the device-visible order is exactly the program order. The
//   sfence before each idx publication is KEPT, now as the Curlee runtime's
//   curlee_sfence extern (rt.c — an "I/O touch / raw memory move" under
//   docs/c-boundary-policy.md §1 that moved out of the deleted
//   kernel/virtio_net.c into the toolchain runtime): x86 TSO + QEMU TCG both
//   execute the volatile stores in program order, but the fence is
//   behavior-preserving belt-and-braces for the QEMU TCG kick-ordering
//   concern the C original documented, and it costs one extern call per ring
//   publication.
//
// No-NIC-safe (acceptance criterion 6): with no virtio-net device, net_probe()
// finds nothing (config reads return 0xFFFFFFFF), net_init()/net_link_up()/
// net_rx_len()/net_tx_send() all return 0, and boot continues to VGA + serial
// + halt. No hang, no crash.
//
// Trust model (mirrors Phys<T> discipline): port I/O and ring DMA are raw,
// trusted access gated by this driver being the only toucher. The RX handoff
// contract (net.h) prevents buffer reuse while the stack owns a frame.
//
// Design laws honored:
//   - Single address space, Ring 0: port I/O is direct x86 in/out asm (the
//     port_inb/outb/inw/outw/inl/outl builtins); ring memory is written via
//     the phys_write_u8/u16/u32/u64 builtins (inline volatile stores).
//   - Deterministic verification: `curlee check virtio_net.curlee` runs
//     standalone and the merged kernel re-verifies it (`make check`).
//   - Minimal footprint: no libc, no String/Vec; every buffer is a Curlee
//     static — the small driver-state arrays plus the ring/buffer memory,
//     sized per build via --define (gh issue #296).

// ---------------------------------------------------------------------------
// Ring/buffer memory + build-geometry getters (gh issue #296 — per-build-
// target static array sizing via `curlee build --define NAME=VALUE`).
// ---------------------------------------------------------------------------

// Ring memory: 3 x 4096 per queue. QEMU aligns the used ring to 4096 relative
// to the queue base (align_up in its legacy vring code), so the BASE MUST be
// 4096-aligned. A bare __attribute__((aligned(4096))) on a static array is not
// reliably honored by the linker for BSS symbols, so we use an over-allocated
// buffer and queue_setup() manually aligns the working base (`(raw + 4095) &
// ~4095UL` — ported verbatim from the C original).
//
// Over-allocation math: the aligned base can be up to (4096-1) bytes past the
// raw start, and we need 3 x 4096 from the aligned base. So the raw buffer
// must be >= 4095 + 3*4096 = 16383 bytes. 5 pages (20480) is safe on both
// sides. Sized per build: NET_QMEM_PAGES=5 on the GRUB build, 1 on the PVH
// build (1-element-stub semantics — the getters return 0 and net_init() bails
// on virtio_net_pvh_build()==1).
static rx_qmem: [U8; NET_QMEM_PAGES * 4096] = [0; NET_QMEM_PAGES * 4096];
static tx_qmem: [U8; NET_QMEM_PAGES * 4096] = [0; NET_QMEM_PAGES * 4096];

// RX/TX data buffers (static, no malloc). Addressed via the base getters; the
// descriptor addr field is the row address (like the C original's
// `(uint64_t)(unsigned long)rx_buf[s]`). NET_RX_BUFS=2 x NET_BUF_BYTES=2048 on
// the GRUB build (>= 256 B: the wire-shape §3.2 absolute response limit; 2048
// covers the ARP frame and the 2d-2 HTTP round trip comfortably), 1 x 1 on
// the PVH build.
static rx_buf: [U8; NET_RX_BUFS * NET_BUF_BYTES] = [0; NET_RX_BUFS * NET_BUF_BYTES];
static tx_buf: [U8; NET_TX_BUFS * NET_BUF_BYTES] = [0; NET_TX_BUFS * NET_BUF_BYTES];

// Build discriminator: 1 on the PVH build (the buffers above are 1-element
// stubs and every base getter returns 0), 0 on the GRUB build. The C
// #define's JOE_PVH_BOOT is now a `--define` build constant folded by the
// parser. net_init() bails on this returning 1 (option 1, see the header).
fn virtio_net_pvh_build() -> Int {
  return JOE_PVH_BOOT;
}

// Base of the RX queue's ring memory (0 on the PVH stub). addr_of (issue
// #286) yields the physical address of the Curlee-owned static; the kernel
// runs with identity paging so virtual == physical. Requires unsafe + cap
// phys.mem (the phys-builtin gate); pm is dropped by codegen.
fn virtio_net_rx_qmem_base(pm: cap phys.mem) -> Int {
  if (JOE_PVH_BOOT == 1) {
    return 0;
  }
  unsafe {
    return addr_of(rx_qmem);
  }
  return 0;
}

// Base of the TX queue's ring memory (0 on the PVH stub).
fn virtio_net_tx_qmem_base(pm: cap phys.mem) -> Int {
  if (JOE_PVH_BOOT == 1) {
    return 0;
  }
  unsafe {
    return addr_of(tx_qmem);
  }
  return 0;
}

// Base address of RX buffer slot `slot` (0 on the PVH stub, or for an
// out-of-range slot — defense-in-depth over the Curlee bounds).
fn virtio_net_rx_buf_base(pm: cap phys.mem, slot: Int) -> Int {
  if (JOE_PVH_BOOT == 1) {
    return 0;
  }
  if (slot >= 0 && slot < NET_RX_BUFS) {
    unsafe {
      return addr_of(rx_buf) + slot * NET_BUF_BYTES;
    }
  }
  return 0;
}

// Base address of TX buffer slot `slot` (0 on the PVH stub, or for an
// out-of-range slot — defense-in-depth over the Curlee bounds).
fn virtio_net_tx_buf_base(pm: cap phys.mem, slot: Int) -> Int {
  if (JOE_PVH_BOOT == 1) {
    return 0;
  }
  if (slot >= 0 && slot < NET_TX_BUFS) {
    unsafe {
      return addr_of(tx_buf) + slot * NET_BUF_BYTES;
    }
  }
  return 0;
}

// Ring-publication store fence (see the PORT NOTE above). Defined in the
// Curlee freestanding runtime (runtime/rt.c) as curlee_sfence — the "I/O
// touch / raw memory move" that used to live in the deleted
// kernel/virtio_net.c, now a toolchain-runtime helper (gh issue #296). The
// codegen emits a direct call to the exact name (no curlee_ mangle).
extern fn curlee_sfence() -> Unit;

// ---------------------------------------------------------------------------
// Driver state (all Curlee statics — the toolchain's static + [T; N] arrays).
// Every value is Int: U8/U16/U32 are used only for ephemeral port/phys reads
// and widened with + 0 into Int at the read site (a bare U value does not
// widen in a `let` — verified at this compiler commit).
// ---------------------------------------------------------------------------

static io_base: Int = 0;            // legacy I/O BAR base of the NIC
static pci_found: Int = 0;          // net_probe() cache
static net_ready: Int = 0;          // net_init() completed (rings live)
static net_status_feature: Int = 0; // VIRTIO_NET_F_STATUS negotiated
static net_link_up_now: Int = 0;
static guest_mac: [Int; 6] = [0; 6];
static mac_known: Int = 0;

// Desc allocation: RX uses desc ids 0..NET_RX_BUFS-1, TX uses
// NET_RX_BUFS..NET_RX_BUFS+NET_TX_BUFS-1. Static split, no free-list.
// rx_ring_base / tx_ring_base cache the 4096-aligned queue bases (the C
// original's rx_desc/rx_avail/rx_used pointer triple) so the service loops
// can compute ring-field addresses.
static rx_ring_base: Int = 0;
static tx_ring_base: Int = 0;

static rx_avail_head: Int = 0;   // number of RX descs added to the avail ring
static tx_avail_head: Int = 0;
// used-ring idx we have consumed. The C original held these as u16 (wrapping
// mod 65536); the device's used->idx is a u16 that wraps the same way, so the
// Curlee counters wrap explicitly with % 65536 to keep the == comparison
// identical (an unwrapped Int would desync after 65536 frames).
static rx_used_last: Int = 0;
static tx_used_last: Int = 0;

// rx_buf_state: 0 = free (re-armable), 1 = armed on ring, 2 = frame ready.
// The stack owns a frame from the first net_rx_len() > 0 until net_rx_done().
static rx_buf_state: [Int; 2] = [0; 2];
static rx_frame_len: [Int; 2] = [0; 2];
static rx_current: Int = -1;          // slot of the frame the stack reads now

static tx_buf_state: [Int; 2] = [0; 2];  // 0 = free, 1 = in flight
static tx_stage: Int = 0;                // slot the stack stages into

static poll_ticks: Int = 0;   // net_poll_tick() fuel (Curlee-owned counter)

// ---------------------------------------------------------------------------
// Ring-geometry helpers (pure Int math; the bases are opaque extern reads so
// these are contract-less — the established canvas/net_glue pattern).
// ---------------------------------------------------------------------------

// Base of vring_desc[s] (16-byte entries on page 0): addr u64 @0, len u32 @8,
// flags u16 @12, next u16 @14.
fn vring_desc_base(base: Int, s: Int) -> Int {
  return base + s * 16;
}

// Address of the avail ring entry for slot s (page 1): flags u16 @0, idx u16
// @2, ring[256] u16 @4.
fn vring_avail_entry(base: Int, s: Int) -> Int {
  return base + 4096 + 4 + s * 2;
}

// Address of the avail/used idx fields (page 1 @2 / page 2 @2).
fn vring_avail_idx_addr(base: Int) -> Int {
  return base + 4096 + 2;
}

fn vring_used_idx_addr(base: Int) -> Int {
  return base + 8192 + 2;
}

// Addresses of used-ring element k's id/len (page 2): flags u16 @0, idx u16
// @2, ring[256] of {id u32 @4, len u32 @8} — 8 bytes per element.
fn vring_used_elem_id_addr(base: Int, k: Int) -> Int {
  return base + 8192 + 4 + k * 8;
}

fn vring_used_elem_len_addr(base: Int, k: Int) -> Int {
  return base + 8192 + 8 + k * 8;
}

// ---------------------------------------------------------------------------
// Virtqueue helpers
// ---------------------------------------------------------------------------

// Cache the 3-page queue base for qsel (the C ring_pointers).
fn ring_pointers(qsel: Int, base: Int) -> Unit {
  if (qsel == 0) {
    rx_ring_base = base;
  } else {
    tx_ring_base = base;
  }
  return;
}

// Kick the device: new buffers are available on queue qsel.
fn queue_notify(pm: cap phys.mem, qsel: Int) -> Unit {
  unsafe {
    port_outw(io_base + 16, qsel);   // VIRTIO_PCI_QUEUE_NOTIFY 0x10
  }
  return;
}

// Program one legacy virtqueue: select, read QUEUE_NUM, zero the 3 pages,
// write QueuePFN = phys >> 12, read back, install the ring base. `raw` is the
// C shim's over-allocated qmem address (5 pages); the working base is the
// first 4096-aligned address inside it (QEMU aligns the used ring to 4096
// relative to this base, so base misalignment would put desc/avail/used on
// the wrong pages). The C original's manual-alignment math `(raw + 4095) &
// ~4095UL` is direct bitwise translation; the `raw == 0` guard is
// defense-in-depth for the PVH stub path (the getter returns 0 there; net_init
// never reaches queue_setup on that path — see the header).
fn queue_setup(pm: cap phys.mem, qsel: Int, raw: Int) -> Int {
  if (raw == 0) {
    return 0;
  }
  unsafe {
    port_outw(io_base + 14, qsel);          // VIRTIO_PCI_QUEUE_SEL 0x0E
    let num: U16 = port_inw(io_base + 12);  // VIRTIO_PCI_QUEUE_NUM 0x0C
    let numi: Int = num + 0;
    if (numi == 0) {
      return 0;
    }
    if (numi > 256) {   // NET_RING_NUM (device wants more than we sized for)
      return 0;
    }
    // Manual 4096-alignment of the working base (see the ring-memory comment).
    let base: Int = (raw + 4095) & ~4095;
    // Zero the 3 pages (3072 x u32 = 12288 bytes) — the C net_zero.
    let i: Int = 0;
    while (i < 3072) {
      phys_write_u32(base + i * 4, 0);
      i = i + 1;
    }
    let pfn: Int = base >> 12;
    port_outl(io_base + 8, pfn);            // VIRTIO_PCI_QUEUE_PFN 0x08
    let rb: U32 = port_inl(io_base + 8);
    let rbi: Int = rb + 0;
    if (rbi != pfn) {
      return 0;
    }
  }
  ring_pointers(qsel, (raw + 4095) & ~4095);
  return 1;
}

// Arm every free RX buffer on the avail ring (fixed slot <-> desc id 1:1).
// The descriptor addr is the buffer's runtime address (from the C shim
// getter), widened to U64 for the u64 field (curlee #277); the pages were
// pre-zeroed by queue_setup so the high dword is already 0 for every buffer
// below 4 GiB.
fn refill_rx(pm: cap phys.mem) -> Unit {
  let armed: Int = 0;
  let s: Int = 0;
  while (s < 2) {   // NET_RX_BUFS
    if (rx_buf_state[s] == 0) {
      let buf: Int = virtio_net_rx_buf_base(pm, s);
      let desc: Int = vring_desc_base(rx_ring_base, s);
      unsafe {
        let a64: U64 = buf;
        phys_write_u64(desc, a64);        // addr
        phys_write_u32(desc + 8, 2048);   // len = NET_BUF_BYTES
        phys_write_u16(desc + 12, 2);     // flags = VRING_DESC_F_WRITE
      }
      let entry: Int = vring_avail_entry(rx_ring_base, rx_avail_head % 256);
      unsafe {
        phys_write_u16(entry, s);
      }
      rx_avail_head = rx_avail_head + 1;
      rx_buf_state[s] = 1;
      armed = armed + 1;
    }
    s = s + 1;
  }
  if (armed > 0) {
    curlee_sfence();   // desc[] + ring[] stores visible before idx
    let idx_addr: Int = vring_avail_idx_addr(rx_ring_base);
    unsafe {
      phys_write_u16(idx_addr, rx_avail_head);
    }
    queue_notify(pm, 0);
  }
  return;
}

// Collect completed RX frames from the used ring into the per-slot state.
// The used->idx read is opaque to the verifier (phys read, no axioms), so the
// consume loop is bounded by a 256-iteration guard (the ring holds at most 256
// elements; with 2 RX buffers the device can never have more than 2 outstanding
// — the guard is provably never exhausted on a live ring and keeps the loop
// terminating for the verifier). The nested-if guards on the opaque id bound
// the rx_buf_state/rx_frame_len array indices (verified shape, issue #14).
fn service_rx_used(pm: cap phys.mem) -> Unit {
  let base: Int = rx_ring_base;
  let last: Int = rx_used_last;
  let guard: Int = 0;
  let idx_addr: Int = vring_used_idx_addr(base);
  unsafe {
    while (guard < 256) {
      let uidx: U16 = phys_read_u16(idx_addr);
      let ui: Int = uidx + 0;
      if (ui == last) {
        guard = 256;   // caught up
      } else {
        let id: U32 = phys_read_u32(vring_used_elem_id_addr(base, last % 256));
        let idi: Int = id + 0;
        if (idi >= 0) {
          if (idi < 2) {   // id < NET_RX_BUFS
            if (rx_buf_state[idi] == 1) {
              let elen: U32 = phys_read_u32(vring_used_elem_len_addr(base, last % 256));
              let eleni: Int = elen + 0;
              rx_frame_len[idi] = eleni;
              rx_buf_state[idi] = 2;   // frame ready (owned by the stack)
            }
          }
        }
        last = (last + 1) % 65536;   // u16 wrap (see the state comment)
      }
    }
  }
  rx_used_last = last;
  return;
}

// Reclaim completed TX frames from the used ring (same guard/nested-if shape).
fn service_tx_used(pm: cap phys.mem) -> Unit {
  let base: Int = tx_ring_base;
  let last: Int = tx_used_last;
  let guard: Int = 0;
  let idx_addr: Int = vring_used_idx_addr(base);
  unsafe {
    while (guard < 256) {
      let uidx: U16 = phys_read_u16(idx_addr);
      let ui: Int = uidx + 0;
      if (ui == last) {
        guard = 256;   // caught up
      } else {
        let id: U32 = phys_read_u32(vring_used_elem_id_addr(base, last % 256));
        let idi: Int = id + 0;
        if (idi >= 2) {
          if (idi < 4) {   // id in [NET_RX_BUFS, NET_RX_BUFS + NET_TX_BUFS)
            tx_buf_state[idi - 2] = 0;   // free again
          }
        }
        last = (last + 1) % 65536;
      }
    }
  }
  tx_used_last = last;
  return;
}

// ---------------------------------------------------------------------------
// PCI config space (legacy ports 0xCF8/0xCFC)
// ---------------------------------------------------------------------------

// 32-bit config read: address assembly is direct bitwise translation of the C
// (0x80000000 | bus<<16 | dev<<11 | func<<8 | (off & 0xFC)). Port reads are
// opaque to the verifier, so the function is contract-less.
fn pci_config_read32(pm: cap phys.mem, bus: Int, dev: Int, func: Int, off: Int) -> Int {
  unsafe {
    let addr: Int = 2147483648 | (bus << 16) | (dev << 11) | (func << 8) | (off & 252);
    port_outl(3320, addr);    // PCI_ADDR_PORT 0xCF8
    let d: U32 = port_inl(3324);   // PCI_DATA_PORT 0xCFC
    let di: Int = d + 0;
    return di;
  }
}

// ---------------------------------------------------------------------------
// Extern surface (the net.h contract — now genuine Curlee functions, codegen'd
// as curlee_net_*; the C shim no longer implements them)
// ---------------------------------------------------------------------------

// 1 = a legacy-capable virtio-net PCI device was found (I/O BAR readable).
fn net_probe(pm: cap phys.mem) -> Int {
  if (pci_found == 1) {
    return 1;
  }
  // Legacy PCI: bus 0 only. Nonexistent devices read 0xFFFFFFFF — safe.
  let dev: Int = 0;
  while (dev < 32) {
    let func: Int = 0;
    while (func < 8) {
      let id: Int = pci_config_read32(pm, 0, dev, func, 0);
      if (id != 4294967295 && id != 0) {   // != 0xFFFFFFFF, != 0
        let vendor: Int = id & 65535;
        let device: Int = (id >> 16) & 65535;
        if (vendor == 6900) {   // 0x1AF4
          if (device == 4096 || device == 4161) {   // 0x1000 legacy, 0x1041 modern
            let bar: Int = pci_config_read32(pm, 0, dev, func, 16);   // 0x10
            if ((bar & 1) != 0) {
              // I/O BAR (legacy transport — the smoke path forces this with
              // disable-modern=on). An MMIO BAR (bit 0 clear) is recognized
              // but not driven on the legacy path (documented fallback).
              let io: Int = bar & 65532;   // 0xFFFC
              if (io != 0) {   // BAR assigned
                io_base = io;
                pci_found = 1;
                return 1;
              }
            }
          }
          // 0x1FE9 (modern-only) and 0x1001 (block) are intentionally never
          // initialized here: 0x1FE9 has no legacy transport, 0x1001 is not
          // a net device.
        }
      }
      func = func + 1;
    }
    dev = dev + 1;
  }
  return 0;
}

// 1 = device ready (rings set up, RX armed). Safe no-op when no NIC.
fn net_init(pm: cap phys.mem) -> Int {
  if (net_ready == 1) {
    return 1;
  }
  if (pci_found == 0) {
    let p: Int = net_probe(pm);
    if (p != 1) {
      return 0;
    }
  }
  if (virtio_net_pvh_build() == 1) {
    return 0;   // option 1 stub (see the file header)
  }
  unsafe {
    // 1. Reset: status = 0, then read back (QEMU resets synchronously). The
    //    loop exits when the status reads 0 or after 100 iterations (bounded).
    port_outb(io_base + 18, 0);   // VIRTIO_PCI_STATUS 0x12
    let g: Int = 0;
    while (g < 100) {
      let st: U8 = port_inb(io_base + 18);
      let sti: Int = st + 0;
      if (sti == 0) {
        g = 100;   // reset confirmed
      } else {
        g = g + 1;
      }
    }
    // 2. Host features -> offer MAC + STATUS, NEVER VERSION_1 (32-bit reg).
    let host: U32 = port_inl(io_base + 0);   // VIRTIO_PCI_HOST_FEATURES 0x00
    let hv: Int = host + 0;
    let guest: Int = 0;
    if ((hv & 32) != 0) {   // 1 << VIRTIO_NET_F_MAC (5)
      guest = guest | 32;
    }
    if ((hv & 65536) != 0) {   // 1 << VIRTIO_NET_F_STATUS (16)
      guest = guest | 65536;
      net_status_feature = 1;
    }
    port_outl(io_base + 4, guest);   // VIRTIO_PCI_GUEST_FEATURES 0x04
    // 3. Status: ACKNOWLEDGE | DRIVER (0x01 | 0x02).
    port_outb(io_base + 18, 3);
    // 4. Set up RX and TX queues (3-page legacy layout each).
    let qrx: Int = queue_setup(pm, 0, virtio_net_rx_qmem_base(pm));
    if (qrx == 0) {
      port_outb(io_base + 18, 128);   // VIRTIO_CONFIG_S_FAILED 0x80
      return 0;
    }
    let qtx: Int = queue_setup(pm, 1, virtio_net_tx_qmem_base(pm));
    if (qtx == 0) {
      port_outb(io_base + 18, 128);
      return 0;
    }
    // 5. Driver OK — device is live (0x01 | 0x02 | 0x04).
    port_outb(io_base + 18, 7);
    // 6. Read the device config (MAC + link status) from BAR0 + 0x14.
    let m: Int = 0;
    while (m < 6) {
      let mb: U8 = port_inb(io_base + 20 + m);   // CONFIG_OFF 20 + MAC 0 + m
      let mbi: Int = mb + 0;
      guest_mac[m] = mbi;
      m = m + 1;
    }
    mac_known = 1;
    if (net_status_feature == 1) {
      let st16: U16 = port_inw(io_base + 26);   // CONFIG_OFF 20 + STATUS 6
      let sti: Int = st16 + 0;
      if ((sti & 1) != 0) {   // VIRTIO_NET_S_LINK_UP 0x01
        net_link_up_now = 1;
      } else {
        net_link_up_now = 0;
      }
    } else {
      // No STATUS feature: nothing to read. QEMU user-net is always up, so
      // 2d-2's link check can proceed (documented assumption).
      net_link_up_now = 1;
    }
  }
  // 7. Arm both RX buffers and kick.
  net_ready = 1;
  refill_rx(pm);
  return 1;
}

// 1 = link up (VIRTIO_NET_S_LINK_UP from the negotiated STATUS feature).
// Pure (statics only) — no port/phys access, so no `pm` needed.
fn net_link_up() -> Int {
  if (net_ready == 1) {
    return net_link_up_now;
  }
  return 0;
}

// Bytes in the current RX frame (0 = none). Also advances the used ring so a
// frame that arrived between polls is collected.
//
// The device writes the 10-byte virtio-net header at the START of the RX
// buffer (see the file-header comment), so the Ethernet frame the stack reads
// starts at byte 10. The reported length is the Ethernet frame length
// (used-ring len minus the header).
fn net_rx_len(pm: cap phys.mem) -> Int {
  if (net_ready == 0) {
    return 0;
  }
  service_rx_used(pm);
  if (rx_current < 0 && rx_buf_state[0] == 2) {
    rx_current = 0;
  } else {
    if (rx_current < 0 && rx_buf_state[1] == 2) {
      rx_current = 1;
    }
  }
  // rx_current is a static, so the verifier treats it as symbolic on entry;
  // the nested-if guards bound the array index (the verified probe shape —
  // return-guards alone are not picked up for array-bounds obligations).
  let cur: Int = rx_current;
  if (cur >= 0) {
    if (cur < 2) {
      if (rx_frame_len[cur] <= 10) {   // VIRTIO_NET_HDR_BYTES
        return 0;   // header-only or undersized — nothing usable
      } else {
        return rx_frame_len[cur] - 10;
      }
    } else {
      return 0;   // defensive: rx_current is only ever -1, 0 or 1
    }
  } else {
    return 0;
  }
}

// Byte i of the held RX frame (0 if none/out of range). 2d-2's byte source.
// Skips the virtio-net header so the stack sees pure Ethernet (byte 0 = dst
// MAC), exactly as it always assumed.
fn net_rx_byte(pm: cap phys.mem, i: Int) -> Int {
  if (net_ready == 0) {
    return 0;
  }
  let cur: Int = rx_current;
  if (cur >= 0) {
    if (cur < 2) {
      if (i < 0 || i >= rx_frame_len[cur] - 10) {
        return 0;
      } else {
        let buf: Int = virtio_net_rx_buf_base(pm, cur);
        unsafe {
          let b: U8 = phys_read_u8(buf + i + 10);
          let bi: Int = b + 0;
          return bi;
        }
      }
    } else {
      return 0;   // defensive (see net_rx_len)
    }
  } else {
    return 0;
  }
}

// Release the held RX frame; the driver reclaims + re-arms the buffer.
fn net_rx_done(pm: cap phys.mem) -> Unit {
  if (net_ready == 0) {
    return;
  }
  let cur: Int = rx_current;
  if (cur >= 0) {
    if (cur < 2) {
      rx_buf_state[cur] = 0;   // free -> refill re-arms it
      rx_current = -1;
      refill_rx(pm);
    }
  }
  return;
}

// Stage byte b at offset i of the TX staging buffer. 1 = ok, 0 = bad index.
fn net_tx_stage_byte(pm: cap phys.mem, i: Int, b: Int) -> Int {
  if (net_ready == 0) {
    return 0;
  }
  if (i < 0 || i >= 2048) {   // NET_BUF_BYTES
    return 0;
  }
  if (b < 0 || b > 255) {
    return 0;
  }
  // Copy the staging slot index to a local first: passing module-level
  // mutable state directly into a capability-parameter call is rejected by
  // the verifier (opaque contract, issue #287) — the value is the same.
  let stage_slot: Int = tx_stage;
  let buf: Int = virtio_net_tx_buf_base(pm, stage_slot);
  unsafe {
    phys_write_u8(buf + i, b);
  }
  return 1;
}

// Queue the staged frame. 1 = queued, 0 = no free TX buffer / not ready.
//
// The stack stages the PURE Ethernet frame at offset 0..len-1; the virtio-net
// header (10 zero bytes, see the file-header comment) is prepended HERE so the
// device sees header + Ethernet on the ring. The descriptor length includes
// the header (len + 10); the frame content is unchanged for the stack.
//
// The shift copies BACKWARDS (k = 0 first moves the HIGHEST staged byte up by
// 10) so the copy never clobbers an unread source byte; the header slot
// [0..9] is zeroed after the copy — the exact C loop order.
fn net_tx_send(pm: cap phys.mem, len: Int) -> Int {
  if (net_ready == 0) {
    return 0;
  }
  if (len <= 0 || len + 10 > 2048) {   // + VIRTIO_NET_HDR_BYTES > NET_BUF_BYTES
    return 0;
  }
  // tx_stage is a static (symbolic on entry); the nested-if guards bound the
  // tx_buf_state array index (the verified probe shape).
  let stage: Int = tx_stage;
  if (stage >= 0) {
    if (stage < 2) {
      if (tx_buf_state[stage] != 0) {
        return 0;   // no free TX slot
      }
      let buf: Int = virtio_net_tx_buf_base(pm, stage);
      unsafe {
        // Shift the staged Ethernet frame up by the header size, then zero
        // the header slot. (The stack staged bytes 0..len-1; the wire needs
        // [header][frame].)
        let k: Int = 0;
        while (k < len) {
          let src: U8 = phys_read_u8(buf + len - 1 - k);
          let s: Int = src + 0;
          phys_write_u8(buf + len - 1 - k + 10, s);
          k = k + 1;
        }
        let j: Int = 0;
        while (j < 10) {
          phys_write_u8(buf + j, 0);
          j = j + 1;
        }
      }
      let desc_id: Int = 2 + stage;   // NET_RX_BUFS + tx_stage
      let desc: Int = vring_desc_base(tx_ring_base, desc_id);
      unsafe {
        let b64: U64 = buf;
        phys_write_u64(desc, b64);        // addr
        phys_write_u32(desc + 8, len + 10);   // len (includes the header)
        phys_write_u16(desc + 12, 0);     // flags 0 — device reads the TX buffer
      }
      curlee_sfence();   // desc[] + ring[] stores visible before idx
      let entry: Int = vring_avail_entry(tx_ring_base, tx_avail_head % 256);
      unsafe {
        phys_write_u16(entry, desc_id);
      }
      tx_avail_head = tx_avail_head + 1;
      tx_buf_state[stage] = 1;
      tx_stage = (tx_stage + 1) % 2;   // NET_TX_BUFS
      let idx_addr: Int = vring_avail_idx_addr(tx_ring_base);
      unsafe {
        phys_write_u16(idx_addr, tx_avail_head);
      }
      queue_notify(pm, 1);
      return 1;
    } else {
      return 0;   // defensive: tx_stage is only ever 0 or 1
    }
  } else {
    return 0;
  }
}

// Byte i of the negotiated guest MAC (0 if unknown). QEMU user-net guests
// use 10.0.2.15 with this MAC as the ARP sender. Pure (statics only).
fn net_mac_byte(i: Int) -> Int {
  if (mac_known == 0) {
    return 0;
  }
  if (i < 0 || i > 5) {
    return 0;
  }
  return guest_mac[i];
}

// Advance the rings and return the Curlee-owned tick counter (bounded-poll
// fuel).
fn net_poll_tick(pm: cap phys.mem) -> Int {
  if (net_ready == 1) {
    service_rx_used(pm);
    service_tx_used(pm);
  }
  poll_ticks = poll_ticks + 1;
  return poll_ticks;
}

// Bounded wait for the first RX frame (deterministic, never hangs): polls the
// used ring up to NET_RX_POLL_MAX iterations, yielding to QEMU's main loop via
// an ISR port read every 256 iterations (a pure memory spin can starve in TCG).
// The C original's `__asm__ volatile("pause")` hint is omitted — it is a hint
// with no behavioral effect on QEMU TCG, and the ISR read is the real yield.
// Returns net_rx_len() when a frame arrives, else 0.
fn net_rx_wait(pm: cap phys.mem) -> Int {
  if (net_ready == 0) {
    return 0;
  }
  let i: Int = 0;
  while (i < 20000000) {   // NET_RX_POLL_MAX
    if ((i & 255) == 0) {
      unsafe {
        let isr: U8 = port_inb(io_base + 19);   // VIRTIO_PCI_ISR 0x13 — yield
      }
      // Re-notify RX in case the original kick raced the idx publish.
      queue_notify(pm, 0);
    }
    service_rx_used(pm);
    // Also reclaim completed TX frames while we wait: the one-shot TCP
    // stack (net_stack.curlee) may have queued the ARP request on this wait
    // (2d-4 keeps that optional path), and both TX slots must be free for
    // the SYN that follows. Without this, a timed-out ARP wait leaves both
    // TX buffers "in flight" forever and net_tx_send() for the SYN fails
    // with "no free TX slot" — the documented 2d-4 blocker.
    service_tx_used(pm);
    if (rx_buf_state[0] == 2 || rx_buf_state[1] == 2) {
      return net_rx_len(pm);
    }
    i = i + 1;
  }
  return 0;
}

// Build + send the deterministic ARP request for the slirp gateway 10.0.2.2
// (the LOCKED frame-injection mechanism: slirp auto-answers, delivering the
// first RX frame). Frame = Ethernet II (14 B) + ARP request (28 B) = 42 B,
// padded to the 60-byte Ethernet minimum. Returns net_tx_send() result.
// Every net_tx_stage_byte return is bound (the verifier rejects calls as
// arguments to other calls); the C original discarded them.
fn net_arp_request_gateway(pm: cap phys.mem) -> Int {
  if (net_ready == 0) {
    return 0;
  }
  // Ethernet II header.
  let i: Int = 0;
  while (i < 6) {
    let s1: Int = net_tx_stage_byte(pm, i, 255);          // dst = broadcast
    let m: Int = net_mac_byte(i);
    let s2: Int = net_tx_stage_byte(pm, 6 + i, m);        // src = our MAC
    i = i + 1;
  }
  let e1: Int = net_tx_stage_byte(pm, 12, 8);             // ethertype = ARP
  let e2: Int = net_tx_stage_byte(pm, 13, 6);             // (0x0806)
  // ARP header.
  let h1: Int = net_tx_stage_byte(pm, 14, 0);             // htype = Ethernet
  let h2: Int = net_tx_stage_byte(pm, 15, 1);
  let p1: Int = net_tx_stage_byte(pm, 16, 8);             // ptype = IPv4
  let p2: Int = net_tx_stage_byte(pm, 17, 0);
  let hl: Int = net_tx_stage_byte(pm, 18, 6);             // hlen
  let pl: Int = net_tx_stage_byte(pm, 19, 4);             // plen
  let o1: Int = net_tx_stage_byte(pm, 20, 0);             // op = request
  let o2: Int = net_tx_stage_byte(pm, 21, 1);
  let j: Int = 0;
  while (j < 6) {
    let m2: Int = net_mac_byte(j);
    let s3: Int = net_tx_stage_byte(pm, 22 + j, m2);      // sha
    j = j + 1;
  }
  let a1: Int = net_tx_stage_byte(pm, 28, 10);            // spa = 10.0.2.15
  let a2: Int = net_tx_stage_byte(pm, 29, 0);             // (slirp guest)
  let a3: Int = net_tx_stage_byte(pm, 30, 2);
  let a4: Int = net_tx_stage_byte(pm, 31, 15);
  let k: Int = 0;
  while (k < 6) {
    let s4: Int = net_tx_stage_byte(pm, 32 + k, 0);       // tha = zeros
    k = k + 1;
  }
  let t1: Int = net_tx_stage_byte(pm, 38, 10);            // tpa = 10.0.2.2
  let t2: Int = net_tx_stage_byte(pm, 39, 0);             // (slirp gateway)
  let t3: Int = net_tx_stage_byte(pm, 40, 2);
  let t4: Int = net_tx_stage_byte(pm, 41, 2);
  // Pad to the 60-byte Ethernet minimum (42 -> 60). Slirp can drop
  // sub-minimum frames; 18 zero pad bytes keep the frame valid.
  let p: Int = 42;
  while (p < 60) {
    let s5: Int = net_tx_stage_byte(pm, p, 0);
    p = p + 1;
  }
  return net_tx_send(pm, 60);   // 14 + 28 + 18 pad = 60 bytes
}
