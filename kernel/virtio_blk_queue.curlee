// virtio-blk legacy virtqueue ring-geometry helpers (pure offsets).
///
/// Mirrors the vring_desc_base / vring_avail_* style in kernel/virtio_net.curlee:
/// a single 4096-aligned base address plus a few pure offset computations.
/// Offsets derive from the device-advertised queue size. The descriptor table
/// is followed by the avail ring; the used ring starts at the next 4096-byte
/// boundary, as required by the legacy transport.
fn vblk_desc_addr(base: Int, s: Int) -> Int
  [ requires s >= 0; ensures result == base + s * 16; ] {
  return base + s * 16;
}

fn vblk_avail_idx_addr(base: Int, size: Int) -> Int
  [ requires true; ensures result == base + size * 16 + 2; ] {
  return base + size * 16 + 2;
}

fn vblk_avail_ring_addr(base: Int, size: Int) -> Int
  [ requires true; ensures result == base + size * 16 + 4; ] {
  return base + size * 16 + 4;
}

fn vblk_used_base(base: Int, size: Int) -> Int {
  return (base + size * 18 + 6 + 4095) & ~4095;
}

fn vblk_used_idx_addr(base: Int, size: Int) -> Int {
  return vblk_used_base(base, size) + 2;
}
